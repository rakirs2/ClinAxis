graph TB
    subgraph External_APIs["External APIs"]
        CT["ClinicalTrials.gov API"]
        PM["PubMed/EUtils API"]
    end

    subgraph Services["Scraper Services"]
        CTS["ClinicalTrialsScrapeService"]
        PMS["PubMedScraperService<br/>IngestPubMedPapersAsync"]
        IPS["InvestigatorPublicationScrubService<br/>ScrubInvestigatorPapersAsync"]
        IES["InvestigatorEnrichmentService"]
    end

    subgraph Repository["StudyRepository"]
        UPS["UpdateStudiesWithClinicalTrialsAsync"]
        FOP["FindOrCreatePersonAsync"]
        SRC["ScrubInvestigatorPapersAsync"]
        GT["GetTableRowCountsAsync"]
        CLR["ClearAsync"]
    end

    subgraph Entities["Database Entities"]
        SE["StudyEntity<br/>+source: ClinicalTrials.gov/v2"]
        PE["PubmedPaperEntity<br/>+source: PubMed/EUtils"]
        IE["InvestigatorPersonEntity<br/>+source: ClinicalTrials.gov"]
        AE["EntityAliasEntity<br/>(entity_type, canonical_id,<br/>source, source_entity_id)"]
