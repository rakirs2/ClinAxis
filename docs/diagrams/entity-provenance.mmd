    subgraph Telemetry["Telemetry / Monitoring"]
        PEV["PipelineEventEntity<br/>(investigator.enrichment, etc.)"]
        TRC["GetTableRowCountsAsync<br/>entity_aliases count"]
    end

    CT -->|studies + investigators| CTS
