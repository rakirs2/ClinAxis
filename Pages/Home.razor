@page "/"
@using System.Net.Http.Json
@inject HttpClient Client
@SupplyParameterFromQuery

<h1>Study Search</h1>

<form method="get" action="/">
    <div class="row mb-3">
        <div class="col-md-6">
            <input name="search" class="form-control" placeholder="Search by title or NCT ID" value="@search" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </div>
</form>

@if (studies != null)
{
    <table class="table table-striped table-hover">
        <thead><tr><th>NCT ID</th><th>Title</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var s in studies)
        {
            <tr><td><a href="/studies/@s.nctId">@s.nctId</a></td><td>@s.briefTitle</td><td>@s.overallStatus</td></tr>
        }
        </tbody>
    </table>
}
else if (searched)
{
    <p>No results found.</p>
}

@code {
    [SupplyParameterFromQuery] private string? search { get; set; }
    private List<StudySummary>? studies;
    private bool searched = false;

    protected override async Task OnInitializedAsync()
    {
        string q = Uri.EscapeDataString(search ?? "");
        studies = await Client.GetFromJsonAsync<StudiesResponse>($"/api/studies?search={q}&page=1&pageSize=50");
        searched = true;
    }

    private class StudiesResponse { public List<StudySummary>? data { get; set; } }
    private class StudySummary { public string? nctId { get; set; } public string? briefTitle { get; set; } public string? overallStatus { get; set; } }
}