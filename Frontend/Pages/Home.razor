@page "/"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpClientFactory

<h1>Study Search</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <input @bind="search" @bind:event="oninput" class="form-control" placeholder="Search by title or NCT ID"
               @onkeydown="HandleKeyDown" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="SearchStudies" disabled="@loading">Search</button>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (studies is not null)
{
    @if (studies.Count == 0)
    {
        <p class="text-muted">No studies found.</p>
    }
    else
    {
        <p class="text-muted">Showing @studies.Count of @total studies</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>NCT ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Conditions</th>
                    <th>Phases</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in studies)
                {
                    <tr>
                        <td><a href="/studies/@s.nctId">@s.nctId</a></td>
                        <td>@s.briefTitle</td>
                        <td><span class="badge bg-@StatusColor(s.overallStatus)">@s.overallStatus</span></td>
                        <td>@(s.conditions is not null ? string.Join(", ", s.conditions) : "")</td>
                        <td>@(s.phases is not null ? string.Join(", ", s.phases) : "")</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private string search = "";
    private int currentPage = 1;
    private int pageSize = 20;
    private int total;
    private int totalPages;
    private bool loading;
    private string? error;
    private List<StudySummary>? studies;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchStudies();
        }
    }

    private async Task SearchStudies()
    {
        await LoadPage(1);
    }

    private async Task GoToPage(int page)
    {
        await LoadPage(page);
    }

    private async Task LoadPage(int page)
    {
        loading = true;
        error = null;
        currentPage = page;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<StudyListResponse>(
                $"/api/studies?page={page}&pageSize={pageSize}&search={Uri.EscapeDataString(search)}");
            if (response is not null)
            {
                studies = response.data;
                total = response.total;
                totalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load studies: {ex.Message}";
            studies = null;
        }
        finally
        {
            loading = false;
        }
    }

    private static string StatusColor(string? status) => status switch
    {
        "ACTIVE" or "RECRUITING" => "success",
        "COMPLETED" => "primary",
        "UNKNOWN" or "WITHDRAWN" => "secondary",
        "TERMINATED" or "SUSPENDED" => "danger",
        _ => "warning"
    };

    private class StudyListResponse
    {
        public List<StudySummary>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class StudySummary
    {
        public string? nctId { get; set; }
        public string? briefTitle { get; set; }
        public string? overallStatus { get; set; }
        public List<string>? conditions { get; set; }
        public List<string>? phases { get; set; }
    }
}
