@page "/"

<h1>Study Search</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <input id="searchInput" class="form-control" placeholder="Search by title or NCT ID" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" onclick="doSearch()">Search</button>
    </div>
</div>

<table id="results" class="table table-striped table-hover" style="display:none">
    <thead>
        <tr>
            <th>NCT ID</th>
            <th>Title</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody id="resultsBody"></tbody>
</table>
<p id="noResults" style="display:none" class="text-muted">No studies found.</p>

<script src="js/site.js"></script>
