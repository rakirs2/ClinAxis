@page "/providers"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<h1>Medicare Providers</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <input @bind="search" @bind:event="oninput" class="form-control" placeholder="Search by provider name" />
    </div>
    <div class="col-md-3">
        <input @bind="specialty" @bind:event="oninput" class="form-control" placeholder="Filter by specialty" />
    </div>
    <div class="col-md-2">
        <input @bind="state" @bind:event="oninput" class="form-control" placeholder="State" maxlength="2" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100" @onclick="SearchProviders" disabled="@loading">Search</button>
    </div>
    <div class="col-md-1">
        <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">Clear</button>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (providers is not null)
{
    @if (providers.Count == 0)
    {
        <p class="text-muted">No providers found.</p>
    }
    else
    {
        <p class="text-muted">Showing @providers.Count of @total providers</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>NPI</th>
                    <th>Specialty</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Medicare</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in providers)
                {
                    <tr>
                        <td><a href="/provider/@p.npi">@p.providerName</a></td>
                        <td>@p.npi</td>
                        <td>@p.primarySpecialty</td>
                        <td>@p.practiceAddressCity</td>
                        <td>@p.practiceAddressState</td>
                        <td>@p.medicareParticipation</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private string search = "";
    private string specialty = "";
    private string state = "";
    private int currentPage = 1;
    private int pageSize = 20;
    private int total;
    private int totalPages;
    private bool loading;
    private string? error;
    private List<ProviderItem>? providers;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
    }

    private async Task SearchProviders()
    {
        await LoadPage(1);
    }

    private async Task ClearFilters()
    {
        search = "";
        specialty = "";
        state = "";
        await LoadPage(1);
    }

    private async Task GoToPage(int page)
    {
        await LoadPage(page);
    }

    private async Task LoadPage(int page)
    {
        loading = true;
        error = null;
        currentPage = page;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var url = $"/api/providers?page={page}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(search))
                url += $"&search={Uri.EscapeDataString(search)}";
            if (!string.IsNullOrWhiteSpace(specialty))
                url += $"&specialty={Uri.EscapeDataString(specialty)}";
            if (!string.IsNullOrWhiteSpace(state))
                url += $"&state={Uri.EscapeDataString(state)}";

            var response = await client.GetFromJsonAsync<ProviderListResponse>(url);
            if (response is not null)
            {
                providers = response.data;
                total = response.total;
                totalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load providers: {ex.Message}";
            providers = null;
        }
        finally
        {
            loading = false;
        }
    }

    private class ProviderListResponse
    {
        public List<ProviderItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class ProviderItem
    {
        public int id { get; set; }
        public Guid uuid { get; set; }
        public string npi { get; set; } = "";
        public string? providerName { get; set; }
        public string? primarySpecialty { get; set; }
        public string? practiceAddressCity { get; set; }
        public string? practiceAddressState { get; set; }
        public string? medicareParticipation { get; set; }
    }
}
