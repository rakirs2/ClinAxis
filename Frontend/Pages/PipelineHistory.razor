@page "/pipeline-runs"
@using System.Net.Http.Json
@using Microsoft.JSInterop
@implements IDisposable
@inject HttpClient Client
@inject IJSRuntime JsRuntime

<h1>Pipeline History</h1>

<div class="mb-3">
    <small class="text-muted">
        Auto-refreshes every 15 seconds.
        Last updated: <strong>@lastUpdated</strong>
    </small>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@* Latest Activity Section *@
<h3 class="mt-3">Latest Activity</h3>
@if (recentEvents is null)
{
    <p class="text-muted">Loading...</p>
}
else if (recentEvents.Count == 0)
{
    <p class="text-muted">No recent activity recorded.</p>
}
else
{
    <div style="max-height: 300px; overflow-y: auto;" class="mb-3 border rounded p-2">
        <table class="table table-sm table-striped mb-0">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Source</th>
                    <th>Event</th>
                    <th>Level</th>
                    <th>Duration</th>
                    <th>Records</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in recentEvents)
                {
                    <tr class="@(evt.level == "Error" ? "table-danger" : evt.level == "Warning" ? "table-warning" : "")">
                        <td>@FormatDate(evt.timestamp)</td>
                        <td>@evt.source</td>
                        <td><code>@evt.eventType</code></td>
                        <td>@LevelBadge(evt.level)</td>
                        <td>@(evt.durationMs is not null ? $"{evt.durationMs}ms" : "")</td>
                        <td>@evt.recordsAffected</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Bar Chart: Scrapes by Event Type (Last 24h) *@
<h3 class="mt-4">Scrapes by Event Type (Last 24h)</h3>
@if (eventTypeStats is null)
{
    <p class="text-muted">Loading...</p>
}
else if (eventTypeStats.Count == 0)
{
    <p class="text-muted">No event type data available.</p>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div style="height: 300px;">
                <canvas id="eventTypeChart"></canvas>
            </div>
        </div>
    </div>
}

@* Pipeline Runs Table (max 100) *@
<h3 class="mt-4">Pipeline Runs</h3>

@if (runsLoading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (runs is null)
{
    <p class="text-muted">Loading...</p>
}
else if (runs.Count == 0)
{
    <p class="text-muted">No pipeline runs recorded yet.</p>
}
else
{
    <p class="text-muted">Showing @runs.Count of @runsTotal pipeline runs.</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Started</th>
                <th>Completed</th>
                <th>Status</th>
                <th>Studies</th>
                <th>Investigators</th>
                <th>PubMed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var run in runs)
            {
                <tr>
                    <td>@run.id</td>
                    <td>@run.startedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                    <td>@run.completedAt?.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                    <td>@StatusBadge(run.status)</td>
                    <td>@run.totalStudies</td>
                    <td>@run.totalInvestigators</td>
                    <td>@run.totalPubmedPapers</td>
                </tr>
            }
        </tbody>
    </table>

    @if (runsTotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(runsCurrentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => LoadRunsPage(runsCurrentPage - 1)">Previous</button>
                </li>
                @foreach (var p in GetPaginationRange(runsCurrentPage, runsTotalPages))
                {
                    @if (p is null)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == runsCurrentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => LoadRunsPage(p.Value)">@p</button>
                        </li>
                    }
                }
                <li class="page-item @(runsCurrentPage >= runsTotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => LoadRunsPage(runsCurrentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<ScrapeEventItem>? recentEvents;
    private List<EventTypeCount>? eventTypeStats;
    private List<PipelineRun>? runs;
    private int runsCurrentPage = 1;
    private int runsPageSize = 20;
    private int runsTotal;
    private int runsTotalPages;
    private bool runsLoading;
    private string? error;
    private string lastUpdated = "";
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        _timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAllData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && eventTypeStats is { Count: > 0 })
        {
            await RenderChart();
        }
    }

    private async Task LoadAllData()
    {
        error = null;
        try
        {
            var telemetryTask = Client.GetFromJsonAsync<TelemetryResponse>("/api/telemetry");
            var statsTask = Client.GetFromJsonAsync<QueueStatsResponse>("/api/event-queue/stats");
            var runsTask = LoadRunsPage(runsCurrentPage);

            await Task.WhenAll(telemetryTask, statsTask, runsTask);

            var telemetry = telemetryTask.Result;
            if (telemetry is not null)
            {
                recentEvents = telemetry.recentEvents;
            }

            var stats = statsTask.Result;
            if (stats?.byEventType is not null)
            {
                eventTypeStats = stats.byEventType
                    .Select(et => new EventTypeCount
                    {
                        eventType = et.eventType,
                        completed = et.completed,
                        failed = et.failed,
                        pending = et.pending,
                        deadLetter = et.deadLetter
                    })
                    .OrderByDescending(et => et.completed + et.failed)
                    .ToList();
            }

            lastUpdated = DateTime.UtcNow.ToString("HH:mm:ss 'UTC'");
        }
        catch (Exception ex)
        {
            error = $"Failed to load data: {ex.Message}";
        }
    }

    private async Task LoadRunsPage(int page)
    {
        runsLoading = true;
        runsCurrentPage = page;
        try
        {
            var result = await Client.GetFromJsonAsync<PipelineListResponse>(
                $"/api/pipeline-runs?page={page}&pageSize={runsPageSize}");
            if (result is not null)
            {
                runs = result.data;
                runsTotal = result.total;
                runsTotalPages = result.totalPages;
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load pipeline runs: {ex.Message}";
        }
        finally
        {
            runsLoading = false;
        }
    }

    private async Task RenderChart()
    {
        if (eventTypeStats is null || eventTypeStats.Count == 0) return;

        var labels = eventTypeStats.Select(e => e.eventType).ToList();
        var datasets = new[]
        {
            new
            {
                label = "Completed",
                data = eventTypeStats.Select(e => e.completed).ToList(),
                backgroundColor = "rgba(40, 167, 69, 0.7)",
                borderColor = "rgba(40, 167, 69, 1)",
                borderWidth = 1
            },
            new
            {
                label = "Failed",
                data = eventTypeStats.Select(e => e.failed).ToList(),
                backgroundColor = "rgba(220, 53, 69, 0.7)",
                borderColor = "rgba(220, 53, 69, 1)",
                borderWidth = 1
            },
            new
            {
                label = "Pending",
                data = eventTypeStats.Select(e => e.pending).ToList(),
                backgroundColor = "rgba(255, 193, 7, 0.7)",
                borderColor = "rgba(255, 193, 7, 1)",
                borderWidth = 1
            }
        };

        await JsRuntime.InvokeVoidAsync("chartInterop.createBarChart", "eventTypeChart", labels, datasets);
    }

    private static RenderFragment StatusBadge(string? status) => builder =>
    {
        var color = status switch
        {
            "Completed" => "success",
            "Failed" => "danger",
            "Running" => "info",
            _ => "warning"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, status);
        builder.CloseElement();
    };

    private static RenderFragment LevelBadge(string? level) => builder =>
    {
        var color = level switch
        {
            "Error" => "danger",
            "Warning" => "warning",
            "Info" => "info",
            _ => "secondary"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, level);
        builder.CloseElement();
    };

    private static List<int?> GetPaginationRange(int current, int total, int maxVisible = 10)
    {
        var range = new List<int?>();
        if (total <= maxVisible)
        {
            for (int i = 1; i <= total; i++) range.Add(i);
            return range;
        }

        int half = maxVisible / 2;
        int start = Math.Max(1, current - half);
        int end = Math.Min(total, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        if (start > 1)
        {
            range.Add(1);
            if (start > 2) range.Add(null);
        }

        for (int i = start; i <= end; i++)
            range.Add(i);

        if (end < total)
        {
            if (end < total - 1) range.Add(null);
            range.Add(total);
        }

        return range;
    }

    private static string FormatDate(DateTime dt) =>
        dt.ToString("yyyy-MM-dd HH:mm 'UTC'");

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private class TelemetryResponse
    {
        public List<ScrapeEventItem>? recentEvents { get; set; }
    }

    private class ScrapeEventItem
    {
        public DateTime timestamp { get; set; }
        public string? source { get; set; }
        public string? eventType { get; set; }
        public string? level { get; set; }
        public long? durationMs { get; set; }
        public int? recordsAffected { get; set; }
    }

    private class QueueStatsResponse
    {
        public List<EventTypeBreakdown>? byEventType { get; set; }
    }

    private class EventTypeBreakdown
    {
        public string eventType { get; set; } = string.Empty;
        public int completed { get; set; }
        public int failed { get; set; }
        public int pending { get; set; }
        public int deadLetter { get; set; }
    }

    private class EventTypeCount
    {
        public string eventType { get; set; } = string.Empty;
        public int completed { get; set; }
        public int failed { get; set; }
        public int pending { get; set; }
        public int deadLetter { get; set; }
    }

    private class PipelineListResponse
    {
        public List<PipelineRun>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class PipelineRun
    {
        public int id { get; set; }
        public DateTime? startedAt { get; set; }
        public DateTime? completedAt { get; set; }
        public string? status { get; set; }
        public int? totalStudies { get; set; }
        public int? totalInvestigators { get; set; }
        public int? totalPubmedPapers { get; set; }
    }
}