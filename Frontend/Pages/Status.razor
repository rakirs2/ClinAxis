@page "/status"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Client
@inject NavigationManager Navigation

<h1>System Status</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" href="/status">System Status</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/database">Database Size</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/completion">Completion</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/duration-trend">Duration Trend</a>
    </li>
</ul>

<div class="mb-3">
    <small class="text-muted">
        Auto-refreshes every 15 seconds.
        Last updated: <strong>@lastUpdated</strong>
    </small>
</div>

@if (telemetry is null)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <h3 class="mt-4">Scraper Progress</h3>
            @if (scraperProgress is null)
            {
                <p class="text-muted">Loading...</p>
            }
            else
            {
                var pct = scraperProgress.percentScraped;
                var pctDisplay = Math.Min(pct, 100).ToString("F1");
                var barClass = pct >= 90 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-danger";
                var statusColor = pct >= 90 ? "success" : pct >= 50 ? "warning" : "danger";
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span>@scraperProgress.totalInDb / @scraperProgress.totalAvailable studies</span>
                        <strong class="text-@statusColor">@pct.ToString("F1")%</strong>
                    </div>
                    <div class="progress" style="height: 24px;">
                        <div class="progress-bar @barClass"
                             role="progressbar"
                             style="width: @pctDisplay%"
                             aria-valuenow="@pctDisplay"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            @pct.ToString("F1")%
                        </div>
                    </div>
                    <small class="text-muted">
                        Last checked: @scraperProgress.lastChecked.ToString("HH:mm 'UTC'")
                    </small>
                </div>
                @if (scraperProgress.estimatedCompletionUtc.HasValue)
                {
                    <small>
                        Ingesting at <strong>@scraperProgress.ingestRatePerHour?.ToString("N0") studies/hr</strong> —
                        estimated completion: <strong>@FormatDate(scraperProgress.estimatedCompletionUtc)</strong>
                        (@scraperProgress.remainingStudies?.ToString("N0") studies remaining)
                    </small>
                }
                else
                {
                    <small class="text-muted">
                        No completed ingest run yet — ETA unavailable until the first run finishes.
                    </small>
                }
                @if (dataSourceStates is { Count: > 0 })
                {
                    var ctState = dataSourceStates.FirstOrDefault(s => s.sourceName == "ClinicalTrials.gov");
                    if (ctState?.backfillStatus is not null)
                    {
                        <div class="mt-2 small">
                            @switch (ctState.backfillStatus)
                            {
                                case "in-progress":
                                    <span class="text-warning">
                                        Backfilling full corpus — <strong>@(ctState.backfillRemainingStudies?.ToString("N0") ?? "?")</strong> studies remaining
                                        (started @FormatDate(ctState.backfillStartedUtc))
                                    </span>
                                    break;
                                case "complete":
                                    <span class="text-success">
                                        Full-corpus sweep complete @FormatDate(ctState.backfillCompletedUtc)
                                    </span>
                                    break;
                                case "failed":
                                    <span class="text-danger">Full-corpus sweep failed — re-triggering on next scrape tick</span>
                                    break;
                            }
                        </div>
                    }
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => RequestIngestRun("incremental")'
                                disabled="@(ingestRunBusy || ctState?.backfillStatus == "in-progress")">
                            Run incremental now
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick='() => RequestIngestRun("full")'
                                disabled="@(ingestRunBusy || ctState?.backfillStatus == "in-progress")">
                            Full re-sync
                        </button>
                        @if (ingestRunBusy)
                        {
                            <span class="text-muted small">Triggering…</span>
                        }
                    </div>
                }
            }
        </div>
        <div class="col-md-6">
            <h3 class="mt-4">Database</h3>
            <table class="table table-sm" style="max-width: 400px">
                <tbody>
                    <tr><th>Studies</th><td>@(telemetry.db?.totalStudies ?? 0)</td></tr>
                    <tr><th>Studies (live, on CT.gov)</th><td>@(telemetry.db?.totalStudiesLive ?? 0)</td></tr>
                    <tr><th>Investigators</th><td>@(telemetry.db?.totalInvestigators ?? 0)</td></tr>
                    <tr><th>PubMed Papers</th><td>@(telemetry.db?.totalPubmedPapers ?? 0)</td></tr>
                    <tr><th>Keywords</th><td>@(telemetry.db?.totalKeywords ?? 0)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h3 class="mt-4">Scraper Progress Today</h3>
            @if (scraperProgress is null)
            {
                <p class="text-muted">Loading...</p>
            }
            else
            {
                <div class="mb-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Studies added in the last 24 hours</span>
                        <strong class="display-6">@scraperProgress.addedLast24h.ToString("N0")</strong>
                    </div>
                    @if (scraperProgress.sinceUtc.HasValue)
                    {
                        <small class="text-muted">
                            Since @scraperProgress.sinceUtc.Value.ToString("MMM d, HH:mm 'UTC'")
                        </small>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h3 class="mt-4">Investigator Enrichment</h3>
            <table class="table table-sm" style="max-width: 400px">
                <tbody>
                    <tr><th>Total Investigators</th><td>@(telemetry.enrichment?.totalInvestigators ?? 0)</td></tr>
                    <tr><th>With NPI</th><td><strong>@(telemetry.enrichment?.withNpi ?? 0) (@(telemetry.enrichment?.npiCoveragePct ?? 0)%)</strong></td></tr>
                    <tr><th>Not Found</th><td>@(telemetry.enrichment?.notFound ?? 0)</td></tr>
                    <tr><th>Ambiguous (2+ matches)</th><td>@(telemetry.enrichment?.ambiguous ?? 0)</td></tr>
                    <tr><th>Not Yet Attempted</th><td>@(telemetry.enrichment?.notAttempted ?? 0)</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h3 class="mt-4">Visitors</h3>
            <table class="table table-sm" style="max-width: 400px">
                <tbody>
                    <tr><th>Today</th><td>@(pageViewsDay?.totalViews ?? 0) views, @(pageViewsDay?.uniqueVisitors ?? 0) unique</td></tr>
                    <tr><th>This week</th><td>@(pageViewsWeek?.totalViews ?? 0) views, @(pageViewsWeek?.uniqueVisitors ?? 0) unique</td></tr>
                    <tr><th>This month</th><td>@(pageViewsMonth?.totalViews ?? 0) views, @(pageViewsMonth?.uniqueVisitors ?? 0) unique</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <h3 class="mt-4">Rejected Investigator Names</h3>
    <p class="text-muted">
        <a href="/data-quality/2">View all with context on the Data Quality page</a>
    </p>
    @if (rejectedNames is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (rejectedNames.Count == 0)
    {
        <p class="text-success">✓ No names currently rejected by NameFilter.</p>
    }
    else
    {
        var byReason = rejectedNames
            .GroupBy(n => n.rejectionReason ?? "Unknown")
            .Select(g => (Reason: g.Key, Count: g.Count()))
            .OrderByDescending(g => g.Count);
        <p>
            <strong>@rejectedNames.Count</strong> distinct names rejected.
            Breakdown:
            @foreach (var (reason, count) in byReason)
            {
                <span class="badge bg-warning text-dark me-1" title="Names rejected by this rule">@reason: @count</span>
            }
        </p>
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-0">Note</label>
                <input class="form-control form-control-sm" @bind="OverrideNote" placeholder="e.g. verified in NPPES registry" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-success" @onclick="() => ApplyOverride(true)" disabled="@(!selectedOverrideIds.Any())">
                    Mark selected as Human
                </button>
                <button class="btn btn-sm btn-danger" @onclick="() => ApplyOverride(false)" disabled="@(!selectedOverrideIds.Any())">
                    Mark selected as Not Human
                </button>
            </div>
        </div>
        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Review</th>
                    <th>Name</th>
                    <th>Occurrences</th>
                    <th>Studies</th>
                    <th>Reason</th>
                    <th>Override</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var name in rejectedNames)
                {
                    <tr>
                        <td>
                            <input type="checkbox" checked="@selectedOverrideIds.Contains(name.id)"
                                   @onchange="e => ToggleSelection(name.id, e.Value)" />
                        </td>
                        <td>@name.name</td>
                        <td>@name.occurrenceCount</td>
                        <td>@name.studyCount</td>
                        <td><code>@name.rejectionReason</code></td>
                        <td>
                            @if (name.isHumanOverride == true)
                            {
                                <span class="badge bg-success">Human</span>
                            }
                            else if (name.isHumanOverride == false)
                            {
                                <span class="badge bg-danger">Not Human</span>
                            }
                            else
                            {
                                <span class="text-muted">Unreviewed</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(name.note))
                            {
                                <span class="text-muted ms-1">@name.note</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Data Source State</h3>
    @if (dataSourceStates is null || dataSourceStates.Count == 0)
    {
        <p class="text-muted">No data sources initialized.</p>
    }
    else
    {
        <table class="table table-sm" style="max-width: 800px">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Last Sync</th>
                    <th>Next Run</th>
                    <th>Status</th>
                    <th>Rejected Keywords</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in dataSourceStates)
                {
                    <tr>
                        <td>@state.sourceName</td>
                        <td>@(state.lastSyncTimestamp.HasValue ? FormatDate(state.lastSyncTimestamp.Value) : "Never")</td>
                        <td>@(state.nextScheduledRun.HasValue ? FormatDate(state.nextScheduledRun.Value) : "N/A")</td>
                        <td>@StatusBadge(state.status)</td>
                        <td>@state.rejectedKeywordsTotal.ToString("N0")</td>
                        <td><small class="text-danger">@(state.errorMessage ?? "")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Scrape Progress</h3>
    @if (dataSourceStates is null || !dataSourceStates.Any(s => s.scrapeProgress != null))
    {
        <p class="text-muted">No scrape runs recorded yet.</p>
    }
    else
    {
        <table class="table table-sm table-striped" style="max-width: 900px">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Processed</th>
                    <th>Total in Run</th>
                    <th>Estimated Remaining</th>
                    <th>Batches</th>
                    <th>Last Batch</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in dataSourceStates.Where(s => s.scrapeProgress != null))
                {
                    var p = state.scrapeProgress!;
                    <tr>
                        <td>@state.sourceName</td>
                        <td><span class="badge bg-@(p.status == "completed" ? "success" : p.status == "in_progress" ? "warning" : "secondary")">@p.status</span></td>
                        <td>@p.recordsProcessed.ToString("N0")</td>
                        <td>@p.totalInRun.ToString("N0")</td>
                        <td>@p.estimatedRemaining.ToString("N0")</td>
                        <td>@p.batchesCompleted.ToString("N0")</td>
                        <td>
                            @if (p.lastBatchAt.HasValue)
                            {
                                <small>
                                    @p.lastBatchRecords?.ToString("N0") records
                                    in @((p.lastBatchDurationMs ?? 0) / 1000.0).ToString("F1")s
                                    @(string.IsNullOrWhiteSpace(p.lastBatchNctRange) ? "" : $"({p.lastBatchNctRange})")
                                </small>
                            }
                            else
                            {
                                <small class="text-muted">awaiting first batch</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Event Queue Health</h3>
    @if (queueStats is not null)
    {
        <table class="table table-sm" style="max-width: 600px">
            <tbody>
                <tr><th>Pending Events</th><td>@queueStats.pendingCount</td></tr>
                <tr><th>Estimated Time Remaining</th><td>@StatusFormatting.FormatDuration(queueStats.estimatedTimeRemainingMs)</td></tr>
                <tr><th>Processing</th><td>@queueStats.processingCount</td></tr>
                <tr><th>Completed</th><td>@queueStats.completedCount</td></tr>
                <tr><th>Dead Letter</th><td><span class="badge bg-@(queueStats.deadLetterCount > 0 ? "danger" : "success")">@queueStats.deadLetterCount</span></td></tr>
                <tr><th>Avg Processing Time</th><td>@(queueStats.averageProcessingTimeMs.ToString("F1"))ms</td></tr>
                <tr><th>Failure Rate</th><td>@((queueStats.failureRate * 100).ToString("F1"))%</td></tr>
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Queue stats not available.</p>
    }

    @if (queueStats?.byEventType is { Count: > 0 })
    {
        var inFlight = queueStats.byEventType.Where(et => et.inFlight != null).ToList();
        if (inFlight.Count > 0)
        {
            <h3 class="mt-4">In-flight Events</h3>
            <table class="table table-sm table-striped" style="max-width: 1000px">
                <thead>
                    <tr>
                        <th>Event Type</th>
                        <th>Claimed At</th>
                        <th>Progress</th>
                        <th>Percent</th>
                        <th>Rate</th>
                        <th>ETA</th>
                        <th>Last Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var et in inFlight)
                    {
                        var f = et.inFlight!;
                        <tr>
                            <td><code>@et.eventType</code> <span class="text-muted">#@f.eventId</span></td>
                            <td>@FormatDate(f.claimedAt)</td>
                            <td>@(f.processed?.ToString("N0") ?? "?") / @(f.total?.ToString("N0") ?? "?")</td>
                            <td>
                                @if (f.percent.HasValue)
                                {
                                    var barClass = f.percent >= 90 ? "bg-success" : f.percent >= 50 ? "bg-warning" : "bg-info";
                                    <div class="progress" style="height: 18px; min-width: 120px">
                                        <div class="progress-bar @barClass" role="progressbar"
                                             style="width: @Math.Min(f.percent.Value, 100).ToString("F1")%">
                                            @f.percent.Value.ToString("F1")%
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>
                            <td>@(f.ratePerMin.HasValue ? $"{f.ratePerMin.Value:N1}/min" : "--")</td>
                            <td>@(f.etaUtc.HasValue ? FormatDate(f.etaUtc.Value) : "--")</td>
                            <td>
                                @if (f.progressUpdatedAt.HasValue)
                                {
                                    <small title="Last batch reported">@FormatDate(f.progressUpdatedAt.Value)</small>
                                }
                                else
                                {
                                    <span class="text-muted">awaiting first batch</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3 class="mt-4">Event Type Breakdown</h3>
        <table class="table table-sm table-striped" style="max-width: 1000px">
            <thead>
                <tr>
                    <th>Event Type</th>
                    <th>Pending</th>
                    <th>Processing</th>
                    <th>Completed</th>
                    <th>Failed</th>
                    <th>Dead Letter</th>
                    <th>Avg Time</th>
                    <th>Done 15m</th>
                    <th>Done 1h</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var et in queueStats.byEventType)
                {
                    var hasIssues = et.failed > 0 || et.deadLetter > 0;
                    var isActive = et.pending > 0 || et.processing > 0;
                    var rowClass = hasIssues ? "table-danger" : isActive ? "table-warning" : "";
                    <tr class="@rowClass">
                        <td><code>@et.eventType</code></td>
                        <td>@et.pending</td>
                        <td>@et.processing</td>
                        <td>@et.completed</td>
                        <td>
                            @if (et.failed > 0) { <span class="badge bg-danger">@et.failed</span> }
                            else { @et.failed }
                        </td>
                        <td>
                            @if (et.deadLetter > 0) { <span class="badge bg-danger">@et.deadLetter</span> }
                            else { @et.deadLetter }
                        </td>
                        <td>@(et.averageProcessingTimeMs > 0 ? $"{et.averageProcessingTimeMs:F1}ms" : "--")</td>
                        <td>
                            @if (et.completedLast15m > 0) { <span class="badge bg-success">@et.completedLast15m</span> }
                            else if (et.processing > 0) { <span class="badge bg-warning">@et.completedLast15m</span> }
                            else { @et.completedLast15m }
                        </td>
                        <td>
                            @if (et.completedLast1h > 0) { <span class="badge bg-success">@et.completedLast1h</span> }
                            else if (et.processing > 0) { <span class="badge bg-warning">@et.completedLast1h</span> }
                            else { @et.completedLast1h }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Scrape Events (last 20)</h3>
    @if (telemetry.recentEvents is null || telemetry.recentEvents.Count == 0)
    {
        <p class="text-muted">No scrape events recorded.</p>
    }
    else
    {
        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Source</th>
                    <th>Type</th>
                    <th>Level</th>
                    <th>Duration</th>
                    <th>Records</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in telemetry.recentEvents)
                {
                    <tr class="@(evt.level == "Error" ? "table-danger" : evt.level == "Warning" ? "table-warning" : "")">
                        <td>@FormatDate(evt.timestamp)</td>
                        <td>@evt.source</td>
                        <td>@evt.eventType</td>
                        <td>@LevelBadge(evt.level)</td>
                        <td>@(evt.durationMs is not null ? $"{evt.durationMs}ms" : "")</td>
                        <td>@evt.recordsAffected</td>
                        <td>@evt.message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private TelemetryResponse? telemetry;
    private List<DataSourceStateItem>? dataSourceStates;
    private QueueStatsItem? queueStats;
    private List<RejectedNameItem>? rejectedNames;
    private ScraperProgressItem? scraperProgress;
    private string lastUpdated = "";
    private Timer? _timer;
    private PageViewsStatsItem? pageViewsDay;
    private PageViewsStatsItem? pageViewsWeek;
    private PageViewsStatsItem? pageViewsMonth;
    private readonly HashSet<Guid> selectedOverrideIds = [];
    private string? OverrideNote { get; set; }
    private bool overrideBusy;
    private bool ingestRunBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        _timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAllData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task LoadAllData()
    {
        try
        {
            telemetry = await Client.GetFromJsonAsync<TelemetryResponse>("/api/telemetry");
            dataSourceStates = await Client.GetFromJsonAsync<List<DataSourceStateItem>>("/api/data-source-state");
            queueStats = await Client.GetFromJsonAsync<QueueStatsItem>("/api/event-queue/stats");
            rejectedNames = await Client.GetFromJsonAsync<List<RejectedNameItem>>("/api/rejected-names");
            scraperProgress = await Client.GetFromJsonAsync<ScraperProgressItem>("/api/scraper-progress");
            pageViewsDay = await Client.GetFromJsonAsync<PageViewsStatsItem>("/api/page-views/stats?period=day");
            pageViewsWeek = await Client.GetFromJsonAsync<PageViewsStatsItem>("/api/page-views/stats?period=week");
            pageViewsMonth = await Client.GetFromJsonAsync<PageViewsStatsItem>("/api/page-views/stats?period=month");
            lastUpdated = DateTime.UtcNow.ToString("HH:mm:ss 'UTC'");
        }
        catch
        {
            // Keep showing last successful data
        }
    }

    private void ToggleSelection(Guid id, object? isChecked)
    {
        if (isChecked is bool isCheckedFlag && isCheckedFlag)
        {
            selectedOverrideIds.Add(id);
        }
        else
        {
            selectedOverrideIds.Remove(id);
        }
    }

    private async Task ApplyOverride(bool isHuman)
    {
        if (overrideBusy || selectedOverrideIds.Count == 0)
        {
            return;
        }

        overrideBusy = true;
        try
        {
            foreach (var id in selectedOverrideIds.ToList())
            {
                await Client.PostAsJsonAsync($"/api/rejected-names/{id}/override",
                    new { isHumanOverride = isHuman, note = string.IsNullOrWhiteSpace(OverrideNote) ? null : OverrideNote });
            }

            selectedOverrideIds.Clear();
            await LoadAllData();
        }
        finally
        {
            overrideBusy = false;
        }
    }

    private async Task RequestIngestRun(string mode)
    {
        if (ingestRunBusy)
        {
            return;
        }

        ingestRunBusy = true;
        try
        {
            await Client.PostAsJsonAsync($"/api/ingest/run?mode={mode}", new { });
            await LoadAllData();
        }
        finally
        {
            ingestRunBusy = false;
        }
    }

    private static string FormatDate(DateTime? dt) =>
        dt?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "";

    private static string FormatDate(DateTime dt) =>
        dt.ToString("yyyy-MM-dd HH:mm 'UTC'");

    private static RenderFragment StatusBadge(string? status) => builder =>
    {
        var color = status switch
        {
            "Completed" => "success",
            "Failed" => "danger",
            "Running" => "info",
            _ => "warning"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, status);
        builder.CloseElement();
    };

    private static RenderFragment LevelBadge(string? level) => builder =>
    {
        var color = level switch
        {
            "Error" => "danger",
            "Warning" => "warning",
            "Info" => "info",
            _ => "secondary"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, level);
        builder.CloseElement();
    };

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private class TelemetryResponse
    {
        public DbStats? db { get; set; }
        public EnrichmentStats? enrichment { get; set; }
