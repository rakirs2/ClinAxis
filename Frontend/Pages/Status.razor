@page "/status"
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Client

<h1>System Status</h1>

<div class="mb-3">
    <small class="text-muted">
        Auto-refreshes every 15 seconds.
        Last updated: <strong>@lastUpdated</strong>
    </small>
</div>

@if (telemetry is null)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <h3 class="mt-4">Database</h3>
            <table class="table table-sm" style="max-width: 400px">
                <tbody>
                    <tr><th>Studies</th><td>@(telemetry.db?.totalStudies ?? 0)</td></tr>
                    <tr><th>Investigators</th><td>@(telemetry.db?.totalInvestigators ?? 0)</td></tr>
                    <tr><th>PubMed Papers</th><td>@(telemetry.db?.totalPubmedPapers ?? 0)</td></tr>
                    <tr><th>Keywords</th><td>@(telemetry.db?.totalKeywords ?? 0)</td></tr>
                    <tr><th>Authors</th><td>@(telemetry.db?.totalAuthors ?? 0)</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h3 class="mt-4">Aggregations</h3>
            <table class="table table-sm" style="max-width: 400px">
                <tbody>
                    <tr><th>PI Aggregations</th><td>@(telemetry.aggregations?.piAggregationCount ?? 0)</td></tr>
                    <tr><th>Category Aggregations</th><td>@(telemetry.aggregations?.categoryAggregationCount ?? 0)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <h3 class="mt-4">Recent Pipeline Runs</h3>
    @if (telemetry.pipelineRuns is null || telemetry.pipelineRuns.Count == 0)
    {
        <p class="text-muted">No pipeline runs recorded.</p>
    }
    else
    {
        <table class="table table-sm table-striped" style="max-width: 800px">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Started</th>
                    <th>Completed</th>
                    <th>Status</th>
                    <th>Studies</th>
                    <th>Investigators</th>
                    <th>PubMed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in telemetry.pipelineRuns)
                {
                    <tr>
                        <td>@run.id</td>
                        <td>@FormatDate(run.startedAt)</td>
                        <td>@FormatDate(run.completedAt)</td>
                        <td>@StatusBadge(run.status)</td>
                        <td>@run.totalStudies</td>
                        <td>@run.totalInvestigators</td>
                        <td>@run.totalPubmedPapers</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Data Source State</h3>
    @if (dataSourceStates is null || dataSourceStates.Count == 0)
    {
        <p class="text-muted">No data sources initialized.</p>
    }
    else
    {
        <table class="table table-sm" style="max-width: 600px">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Last Sync</th>
                    <th>Status</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in dataSourceStates)
                {
                    <tr>
                        <td>@state.sourceName</td>
                        <td>@(state.lastSyncTimestamp.HasValue ? FormatDate(state.lastSyncTimestamp.Value) : "Never")</td>
                        <td>@StatusBadge(state.status)</td>
                        <td><small class="text-danger">@(state.errorMessage ?? "")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Event Queue Health</h3>
    @if (queueStats is not null)
    {
        <table class="table table-sm" style="max-width: 600px">
            <tbody>
                <tr><th>Pending Events</th><td>@queueStats.pendingCount</td></tr>
                <tr><th>Estimated Time Remaining</th><td>@FormatDuration(queueStats.estimatedTimeRemainingMs)</td></tr>
                <tr><th>Processing</th><td>@queueStats.processingCount</td></tr>
                <tr><th>Completed</th><td>@queueStats.completedCount</td></tr>
                <tr><th>Dead Letter</th><td><span class="badge bg-@(queueStats.deadLetterCount > 0 ? "danger" : "success")">@queueStats.deadLetterCount</span></td></tr>
                <tr><th>Avg Processing Time</th><td>@(queueStats.averageProcessingTimeMs.ToString("F1"))ms</td></tr>
                <tr><th>Failure Rate</th><td>@((queueStats.failureRate * 100).ToString("F1"))%</td></tr>
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Queue stats not available.</p>
    }

    <h3 class="mt-4">Dead Letter Queue @if (deadLetterCount > 0) { <span class="badge bg-danger">@deadLetterCount</span> }</h3>
    @if (deadLetterEvents is null || deadLetterEvents.Count == 0)
    {
        <p class="text-success">✓ No failed events requiring manual intervention.</p>
    }
    else
    {
        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Event Type</th>
                    <th>Created</th>
                    <th>Retries</th>
                    <th>Error</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in deadLetterEvents)
                {
                    <tr class="table-danger">
                        <td>@evt.id</td>
                        <td>@evt.eventType</td>
                        <td>@FormatDate(evt.createdAt)</td>
                        <td>@evt.retryCount</td>
                        <td><small>@evt.errorMessage</small></td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => RetryDeadLetter(evt.id)">Retry</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => IgnoreDeadLetter(evt.id)">Ignore</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3 class="mt-4">Scrape Events (last 20)</h3>
    @if (telemetry.recentEvents is null || telemetry.recentEvents.Count == 0)
    {
        <p class="text-muted">No scrape events recorded.</p>
    }
    else
    {
        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Source</th>
                    <th>Type</th>
                    <th>Level</th>
                    <th>Duration</th>
                    <th>Records</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in telemetry.recentEvents)
                {
                    <tr class="@(evt.level == "Error" ? "table-danger" : evt.level == "Warning" ? "table-warning" : "")">
                        <td>@FormatDate(evt.timestamp)</td>
                        <td>@evt.source</td>
                        <td>@evt.eventType</td>
                        <td>@LevelBadge(evt.level)</td>
                        <td>@(evt.durationMs is not null ? $"{evt.durationMs}ms" : "")</td>
                        <td>@evt.recordsAffected</td>
                        <td>@evt.message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private TelemetryResponse? telemetry;
    private List<DataSourceStateItem>? dataSourceStates;
    private QueueStatsItem? queueStats;
    private List<DeadLetterEventItem>? deadLetterEvents;
    private int deadLetterCount = 0;
    private string lastUpdated = "";
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        _timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAllData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task LoadAllData()
    {
        try
        {
            telemetry = await Client.GetFromJsonAsync<TelemetryResponse>("/api/telemetry");
            dataSourceStates = await Client.GetFromJsonAsync<List<DataSourceStateItem>>("/api/data-source-state");
            queueStats = await Client.GetFromJsonAsync<QueueStatsItem>("/api/event-queue/stats");
            deadLetterEvents = await Client.GetFromJsonAsync<List<DeadLetterEventItem>>("/api/event-queue/dead-letter");
            deadLetterCount = deadLetterEvents?.Count ?? 0;
            lastUpdated = DateTime.Now.ToString("HH:mm:ss");
        }
        catch
        {
            // Keep showing last successful data
        }
    }

    private async Task RetryDeadLetter(int eventId)
    {
        await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/retry", null);
        await LoadAllData();
        StateHasChanged();
    }

    private async Task IgnoreDeadLetter(int eventId)
    {
        await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/ignore", null);
        await LoadAllData();
        StateHasChanged();
    }

    private static string FormatDate(DateTime? dt) =>
        dt?.ToString("yyyy-MM-dd HH:mm") ?? "";

    private static string FormatDate(DateTime dt) =>
        dt.ToString("yyyy-MM-dd HH:mm");

    private static string FormatDuration(double? ms)
    {
        if (ms is not > 0)
            return "--";
        var totalSeconds = (int)(ms.Value / 1000);
        var minutes = totalSeconds / 60;
        var seconds = totalSeconds % 60;
        return minutes > 0 ? $"~{minutes}m {seconds}s" : $"~{seconds}s";
    }

    private static RenderFragment StatusBadge(string? status) => builder =>
    {
        var color = status switch
        {
            "Completed" => "success",
            "Failed" => "danger",
            "Running" => "info",
            _ => "warning"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, status);
        builder.CloseElement();
    };

    private static RenderFragment LevelBadge(string? level) => builder =>
    {
        var color = level switch
        {
            "Error" => "danger",
            "Warning" => "warning",
            "Info" => "info",
            _ => "secondary"
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge bg-{color}");
        builder.AddContent(2, level);
        builder.CloseElement();
    };

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private class TelemetryResponse
    {
        public DbStats? db { get; set; }
        public List<PipelineRunItem>? pipelineRuns { get; set; }
        public List<ScrapeEventItem>? recentEvents { get; set; }
        public AggStats? aggregations { get; set; }
    }

    private class DbStats
    {
        public int totalStudies { get; set; }
        public int totalInvestigators { get; set; }
        public int totalPubmedPapers { get; set; }
        public int totalKeywords { get; set; }
        public int totalAuthors { get; set; }
    }

    private class PipelineRunItem
    {
        public int id { get; set; }
        public DateTime? startedAt { get; set; }
        public DateTime? completedAt { get; set; }
        public string? status { get; set; }
        public int? totalStudies { get; set; }
        public int? totalInvestigators { get; set; }
        public int? totalPubmedPapers { get; set; }
    }

    private class ScrapeEventItem
    {
        public int id { get; set; }
        public DateTime timestamp { get; set; }
        public string? source { get; set; }
        public string? eventType { get; set; }
        public string? level { get; set; }
        public long? durationMs { get; set; }
        public int? recordsAffected { get; set; }
        public string? message { get; set; }
    }

    private class AggStats
    {
        public int piAggregationCount { get; set; }
        public int categoryAggregationCount { get; set; }
    }

    private class DataSourceStateItem
    {
        public string? sourceName { get; set; }
        public DateTime? lastSyncTimestamp { get; set; }
        public string? status { get; set; }
        public string? errorMessage { get; set; }
        public DateTime updatedAt { get; set; }
    }

    private class QueueStatsItem
    {
        public int pendingCount { get; set; }
        public int processingCount { get; set; }
        public int completedCount { get; set; }
        public int deadLetterCount { get; set; }
        public int failedCount { get; set; }
        public double averageProcessingTimeMs { get; set; }
        public double failureRate { get; set; }
        public double? estimatedTimeRemainingMs { get; set; }
    }

    private class DeadLetterEventItem
    {
        public int id { get; set; }
        public string? eventType { get; set; }
        public string? data { get; set; }
        public string? status { get; set; }
        public string? errorMessage { get; set; }
        public int retryCount { get; set; }
        public DateTime createdAt { get; set; }
        public DateTime? completedAt { get; set; }
    }
}
