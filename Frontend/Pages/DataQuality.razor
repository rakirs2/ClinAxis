@page "/data-quality"
@page "/data-quality/{Tab:int}"
@using System.Net.Http.Json
@inject HttpClient Client
@inject NavigationManager Navigation

<h1>Data Quality</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(activeTab == 0 ? "active" : "")" href="/data-quality/0">Failed Events</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 1 ? "active" : "")" href="/data-quality/1">Rejected Keywords</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 2 ? "active" : "")" href="/data-quality/2">Rejected Names</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 3 ? "active" : "")" href="/data-quality/3">NPI Enrichment</a>
    </li>
</ul>

@if (activeTab == 0)
{
    @if (dlLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (dlError is not null)
    {
        <div class="alert alert-danger">@dlError</div>
    }
    else if (dlEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (dlEvents.Count == 0)
    {
        <p class="text-success">&#10003; No failed events requiring manual intervention.</p>
    }
    else
    {
        <p class="text-muted">Showing @dlEvents.Count of @dlTotal dead-letter events</p>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Event Type</th>
                    <th>Payload</th>
                    <th>Created</th>
                    <th>Retries</th>
                    <th>Error</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in dlEvents)
                {
                    <tr class="table-danger">
                        <td>@evt.id</td>
                        <td><code>@evt.eventType</code></td>
                        <td><small>@TruncatePayload(evt.data)</small></td>
                        <td>@FormatDate(evt.createdAt)</td>
                        <td>@evt.retryCount</td>
                        <td><small title="@evt.errorMessage">@TruncateText(evt.errorMessage, 80)</small></td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => DlRetryEvent(evt.id)" disabled="@busyEventId.HasValue">Retry</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => DlIgnoreEvent(evt.id)" disabled="@busyEventId.HasValue">Ignore</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (dlTotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(dlCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadDlPage(dlCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in GetPaginationRange(dlCurrentPage, dlTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == dlCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadDlPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(dlCurrentPage >= dlTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadDlPage(dlCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 1)
{
    @if (kwLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (kwError is not null)
    {
        <div class="alert alert-danger">@kwError</div>
    }
    else if (kwEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (kwEvents.Count == 0)
    {
        <p class="text-success">&#10003; No rejected keywords recorded.</p>
    }
    else
    {
        <p class="text-muted">Showing @kwEvents.Count of @kwTotal rejected keywords</p>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Keyword</th>
                    <th>Study NCT ID</th>
                    <th>Rejected At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in kwEvents)
                {
                    <tr>
                        <td><code>@item.value</code></td>
                        <td>@item.studyNctId</td>
                        <td>@FormatDate(item.rejectedAt)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (kwTotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(kwCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadKwPage(kwCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in GetPaginationRange(kwCurrentPage, kwTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == kwCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadKwPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(kwCurrentPage >= kwTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadKwPage(kwCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 2)
{
    @if (nmLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (nmError is not null)
    {
        <div class="alert alert-danger">@nmError</div>
    }
    else if (nmEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (nmEvents.Count == 0)
    {
        <p class="text-success">&#10003; No rejected investigator names recorded.</p>
    }
    else
    {
        <p class="text-muted">Showing @nmEvents.Count of @nmTotal rejected investigator names</p>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Study NCT ID</th>
                    <th>Rejected At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in nmEvents)
                {
                    <tr>
