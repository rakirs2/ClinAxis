@page "/data-quality"
@page "/data-quality/{Tab:int}"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Client

<h1>Data Quality</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(activeTab == 0 ? "active" : "")" href="/data-quality/0">Failed Events</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 1 ? "active" : "")" href="/data-quality/1">Rejected Keywords</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 2 ? "active" : "")" href="/data-quality/2">Rejected Names</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == 3 ? "active" : "")" href="/data-quality/3">NPI Enrichment</a>
    </li>
</ul>

@if (activeTab == 0)
{
    @if (dlLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (dlError is not null)
    {
        <div class="alert alert-danger">@dlError</div>
    }
    else if (dlEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (dlEvents.Count == 0)
    {
        <p class="text-success">&#10003; No failed events requiring manual intervention.</p>
    }
    else
    {
        <p class="text-muted">Showing @dlEvents.Count of @dlTotal dead-letter events</p>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Event Type</th>
                    <th>Payload</th>
                    <th>Created</th>
                    <th>Retries</th>
                    <th>Error</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in dlEvents)
                {
                    <tr class="table-danger">
                        <td>@evt.id</td>
                        <td><code>@evt.eventType</code></td>
                        <td><small>@DataQualityFormatting.TruncatePayload(evt.data)</small></td>
                        <td>@DataQualityFormatting.FormatDate(evt.createdAt)</td>
                        <td>@evt.retryCount</td>
                        <td>
                            @if (!string.IsNullOrEmpty(evt.errorMessage) && evt.errorMessage.Length > 80)
                            {
                                <details>
                                    <summary style="cursor:pointer"><small>@DataQualityFormatting.TruncateText(evt.errorMessage, 80)</small></summary>
                                    <pre class="mt-1 p-2 bg-light border rounded" style="max-height:300px; overflow-y:auto; font-size:0.75rem; white-space:pre-wrap">@evt.errorMessage</pre>
                                </details>
                            }
                            else
                            {
                                <small>@evt.errorMessage</small>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => DlRetryEvent(evt.id)" disabled="@busyEventId.HasValue">Retry</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => DlIgnoreEvent(evt.id)" disabled="@busyEventId.HasValue">Ignore</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (dlTotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(dlCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadDlPage(dlCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in PaginationHelpers.GetPaginationRange(dlCurrentPage, dlTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == dlCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadDlPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(dlCurrentPage >= dlTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadDlPage(dlCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 1)
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <a href="/api/export/training/keywords" class="btn btn-sm btn-outline-secondary">Download Keywords CSV</a>
            <a href="/api/export/training/conditions" class="btn btn-sm btn-outline-secondary ms-1">Download Conditions CSV</a>
        </div>
    </div>
    @if (kwLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (kwError is not null)
    {
        <div class="alert alert-danger">@kwError</div>
    }
    else if (kwEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (kwEvents.Count == 0)
    {
        <p class="text-success">&#10003; No rejected keywords recorded.</p>
    }
    else
    {
        <p class="text-muted">Showing @kwEvents.Count of @kwTotal rejected keywords</p>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Keyword</th>
                    <th>Study NCT ID</th>
                    <th>Rejected At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in kwEvents)
                {
                    <tr>
                        <td><code>@item.value</code></td>
                        <td>@item.studyNctId</td>
                        <td>@DataQualityFormatting.FormatDate(item.rejectedAt)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (kwTotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(kwCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadKwPage(kwCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in PaginationHelpers.GetPaginationRange(kwCurrentPage, kwTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == kwCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadKwPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(kwCurrentPage >= kwTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadKwPage(kwCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 2)
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <a href="/api/export/training/names" class="btn btn-sm btn-outline-secondary">Download Names CSV</a>
        </div>
    </div>
    @if (nmLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (nmError is not null)
    {
        <div class="alert alert-danger">@nmError</div>
    }
    else if (nmEvents is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (nmEvents.Count == 0)
    {
        <p class="text-success">&#10003; No rejected investigator names recorded.</p>
    }
    else
    {
        <p class="text-muted">Showing @nmEvents.Count of @nmTotal rejected investigator names</p>

        <div class="row g-2 mb-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-0">Reason</label>
                <input class="form-control form-control-sm" @bind="NmFilterReason" placeholder="e.g. OrgKeywords:UNIVERSITY" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Role</label>
                <input class="form-control form-control-sm" @bind="NmFilterRole" placeholder="e.g. SPONSOR" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Affiliation</label>
                <input class="form-control form-control-sm" @bind="NmFilterAffiliation" placeholder="contains..." />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">NCT ID</label>
                <input class="form-control form-control-sm" @bind="NmFilterNctId" placeholder="NCT00000001" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="() => ApplyNmFilters()">Filter</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResetNmFilters()">Reset</button>
            </div>
        </div>

        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Affiliation</th>
                    <th>Reason</th>
                    <th>Study NCT ID</th>
                    <th>Rejected At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in nmEvents)
                {
                    <tr>
                        <td><code>@item.value</code></td>
                        <td>@item.role</td>
                        <td>@item.affiliation</td>
                        <td><code>@item.rejectionReason</code></td>
                        <td>@item.studyNctId</td>
                        <td>@DataQualityFormatting.FormatDate(item.rejectedAt)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (nmTotalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(nmCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadNmPage(nmCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in PaginationHelpers.GetPaginationRange(nmCurrentPage, nmTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == nmCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadNmPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(nmCurrentPage >= nmTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadNmPage(nmCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 3)
{
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <a href="/api/export/training/affiliations" class="btn btn-sm btn-outline-secondary">Download Affiliations CSV</a>
        </div>
    </div>
    @if (enrichmentLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (enrichmentError is not null)
    {
        <div class="alert alert-danger">@enrichmentError</div>
    }
    else if (enrichmentBreakdown is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-2 mb-3">
                <div class="card text-bg-success">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@DataQualityFormatting.GetCount(enrichmentBreakdown, "assigned")</h5>
                        <p class="card-text">Assigned</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@DataQualityFormatting.GetCount(enrichmentBreakdown, "ambiguous")</h5>
                        <p class="card-text">Ambiguous</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-secondary">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@DataQualityFormatting.GetCount(enrichmentBreakdown, "not_found")</h5>
                        <p class="card-text">Not Found</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-danger">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@DataQualityFormatting.GetCount(enrichmentBreakdown, "error")</h5>
                        <p class="card-text">Error</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-info">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@DataQualityFormatting.GetCount(enrichmentBreakdown, "pending")</h5>
                        <p class="card-text">Pending</p>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int Tab { get; set; } = 0;

    private int activeTab = 0;

    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab;
        await LoadDataForTab(activeTab);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (activeTab != Tab)
        {
            activeTab = Tab;
            await LoadDataForTab(Tab);
        }
    }

    private async Task LoadDataForTab(int tab)
    {
        if (tab == 0)
            await LoadDlPage(1);
        else if (tab == 1)
            await LoadKwPage(1);
        else if (tab == 2)
            await LoadNmPage(1);
        else if (tab == 3)
            await LoadEnrichmentBreakdown();
    }

    // ============== Dead Letter Tab ==============

    private List<DeadLetterItem>? dlEvents;
    private int dlCurrentPage = 1;
    private int dlPageSize = 20;
    private int dlTotal;
    private int dlTotalPages;
    private bool dlLoading;
    private string? dlError;
    private int? busyEventId;

    private async Task LoadDlPage(int page)
    {
        dlLoading = true;
        dlError = null;
        dlCurrentPage = page;
        try
        {
            var response = await Client.GetFromJsonAsync<DeadLetterListResponse>(
                $"/api/event-queue/dead-letter?page={page}&pageSize={dlPageSize}");
            if (response is not null)
            {
                dlEvents = response.data;
                dlTotal = response.total;
                dlTotalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            dlError = $"Failed to load dead-letter events: {ex.Message}";
            dlEvents = null;
        }
        finally
        {
            dlLoading = false;
        }
    }

    private async Task DlRetryEvent(int eventId)
    {
        busyEventId = eventId;
        try
        {
            await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/retry", null);
            await LoadDlPage(dlCurrentPage);
        }
        catch
        {
            dlError = "Failed to retry event.";
        }
        finally
        {
            busyEventId = null;
        }
    }

    private async Task DlIgnoreEvent(int eventId)
    {
        busyEventId = eventId;
        try
        {
            await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/ignore", null);
            await LoadDlPage(dlCurrentPage);
        }
        catch
        {
            dlError = "Failed to ignore event.";
        }
        finally
        {
            busyEventId = null;
        }
    }

    // ============== Rejected Entities Tab ==============

    private List<RejectedEntityItem>? kwEvents;
    private int kwCurrentPage = 1;
    private int kwTotal;
    private int kwTotalPages;
    private bool kwLoading;
    private string? kwError;

    private List<RejectedEntityItem>? nmEvents;
    private int nmCurrentPage = 1;
    private int nmTotal;
    private int nmTotalPages;
    private bool nmLoading;
    private string? nmError;
    private string? NmFilterReason { get; set; }
    private string? NmFilterRole { get; set; }
    private string? NmFilterAffiliation { get; set; }
    private string? NmFilterNctId { get; set; }

    private async Task LoadRejectedPage(string entityType, int page)
    {
        if (entityType == "keyword")
        {
            kwLoading = true;
            kwError = null;
            kwCurrentPage = page;
        }
        else
        {
            nmLoading = true;
            nmError = null;
            nmCurrentPage = page;
        }

        try
        {
            var query = $"/api/rejected-entities?type={entityType}&page={page}&pageSize=50";
            if (entityType == "investigator_name")
            {
                var filters = new (string Name, string? Value)[]
                {
                    ("reason", NmFilterReason),
                    ("role", NmFilterRole),
                    ("affiliation", NmFilterAffiliation),
                    ("nctId", NmFilterNctId)
                };
                foreach (var (name, value) in filters)
                {
                    if (!string.IsNullOrWhiteSpace(value))
                    {
                        query += $"&{name}={Uri.EscapeDataString(value)}";
                    }
                }
            }

            var response = await Client.GetFromJsonAsync<RejectedEntityListResponse>(query);
            if (response is not null)
            {
                if (entityType == "keyword")
                {
                    kwEvents = response.data;
                    kwTotal = response.total;
                    kwTotalPages = response.totalPages;
                }
                else
                {
                    nmEvents = response.data;
                    nmTotal = response.total;
                    nmTotalPages = response.totalPages;
                }
            }
        }
        catch (Exception ex)
        {
            if (entityType == "keyword")
            {
                kwError = $"Failed to load: {ex.Message}";
                kwEvents = null;
            }
            else
            {
                nmError = $"Failed to load: {ex.Message}";
                nmEvents = null;
            }
        }
        finally
        {
            if (entityType == "keyword")
                kwLoading = false;
            else
                nmLoading = false;
        }
    }

    private async Task LoadKwPage(int page) => await LoadRejectedPage("keyword", page);
    private async Task LoadNmPage(int page) => await LoadRejectedPage("investigator_name", page);

    private async Task ApplyNmFilters() => await LoadRejectedPage("investigator_name", 1);

    private async Task ResetNmFilters()
    {
        NmFilterReason = null;
        NmFilterRole = null;
        NmFilterAffiliation = null;
        NmFilterNctId = null;
        await LoadRejectedPage("investigator_name", 1);
    }

    // ============== NPI Enrichment Tab ==============

    private Dictionary<string, int>? enrichmentBreakdown;
    private bool enrichmentLoading;
    private string? enrichmentError;

    private async Task LoadEnrichmentBreakdown()
    {
        enrichmentLoading = true;
        enrichmentError = null;
        try
        {
            enrichmentBreakdown = await Client.GetFromJsonAsync<Dictionary<string, int>>("/api/enrichment/breakdown");
        }
        catch (Exception ex)
        {
            enrichmentError = $"Failed to load: {ex.Message}";
            enrichmentBreakdown = null;
        }
        finally
        {
            enrichmentLoading = false;
        }
    }

    // ============== DTOs ==============

    private class DeadLetterItem
    {
        public int id { get; set; }
        public string? eventType { get; set; }
        public string? data { get; set; }
        public string? status { get; set; }
        public string? errorMessage { get; set; }
        public int retryCount { get; set; }
        public DateTime createdAt { get; set; }
        public DateTime? completedAt { get; set; }
    }

    private class DeadLetterListResponse
    {
        public List<DeadLetterItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class RejectedEntityItem
    {
        public int id { get; set; }
        public string? entityType { get; set; }
        public string? value { get; set; }
        public string? studyNctId { get; set; }
        public string? role { get; set; }
        public string? affiliation { get; set; }
        public string? rejectionReason { get; set; }
        public DateTime rejectedAt { get; set; }
    }

    private class RejectedEntityListResponse
    {
        public List<RejectedEntityItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }
}
