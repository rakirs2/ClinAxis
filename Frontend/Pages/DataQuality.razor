            <nav>
                <ul class="pagination">
                    <li class="page-item @(nmCurrentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadNmPage(nmCurrentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in GetPaginationRange(nmCurrentPage, nmTotalPages))
                    {
                        @if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == nmCurrentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadNmPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(nmCurrentPage >= nmTotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => LoadNmPage(nmCurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}
else if (activeTab == 3)
{
    @if (enrichmentLoading)
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (enrichmentError is not null)
    {
        <div class="alert alert-danger">@enrichmentError</div>
    }
    else if (enrichmentBreakdown is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-2 mb-3">
                <div class="card text-bg-success">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@GetCount("assigned")</h5>
                        <p class="card-text">Assigned</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@GetCount("ambiguous")</h5>
                        <p class="card-text">Ambiguous</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-secondary">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@GetCount("not_found")</h5>
                        <p class="card-text">Not Found</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-danger">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@GetCount("error")</h5>
                        <p class="card-text">Error</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-bg-info">
                    <div class="card-body text-center">
                        <h5 class="card-title display-6">@GetCount("pending")</h5>
                        <p class="card-text">Pending</p>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int Tab { get; set; } = 0;

    private int activeTab = 0;

    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab;
        await LoadDlPage(1);
        if (activeTab == 1)
            await LoadKwPage(1);
        else if (activeTab == 2)
            await LoadNmPage(1);
        else if (activeTab == 3)
            await LoadEnrichmentBreakdown();
    }

    // ============== Dead Letter Tab ==============

    private List<DeadLetterItem>? dlEvents;
    private int dlCurrentPage = 1;
    private int dlPageSize = 20;
    private int dlTotal;
    private int dlTotalPages;
    private bool dlLoading;
    private string? dlError;
    private int? busyEventId;

    private async Task LoadDlPage(int page)
    {
        dlLoading = true;
        dlError = null;
        dlCurrentPage = page;
        try
        {
            var response = await Client.GetFromJsonAsync<DeadLetterListResponse>(
                $"/api/event-queue/dead-letter?page={page}&pageSize={dlPageSize}");
            if (response is not null)
            {
                dlEvents = response.data;
                dlTotal = response.total;
                dlTotalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            dlError = $"Failed to load dead-letter events: {ex.Message}";
            dlEvents = null;
        }
        finally
        {
            dlLoading = false;
        }
    }

    private async Task DlRetryEvent(int eventId)
    {
        busyEventId = eventId;
        try
        {
            await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/retry", null);
            await LoadDlPage(dlCurrentPage);
        }
        catch
        {
            dlError = "Failed to retry event.";
        }
        finally
        {
            busyEventId = null;
        }
    }

    private async Task DlIgnoreEvent(int eventId)
    {
        busyEventId = eventId;
        try
        {
            await Client.PostAsync($"/api/event-queue/dead-letter/{eventId}/ignore", null);
            await LoadDlPage(dlCurrentPage);
        }
        catch
        {
            dlError = "Failed to ignore event.";
        }
        finally
        {
            busyEventId = null;
        }
    }

    // ============== Rejected Entities Tab ==============

    private List<RejectedEntityItem>? kwEvents;
    private int kwCurrentPage = 1;
    private int kwTotal;
    private int kwTotalPages;
    private bool kwLoading;
    private string? kwError;

    private List<RejectedEntityItem>? nmEvents;
    private int nmCurrentPage = 1;
    private int nmTotal;
    private int nmTotalPages;
    private bool nmLoading;
    private string? nmError;

    private async Task LoadRejectedPage(string entityType, int page)
    {
        if (entityType == "keyword")
        {
            kwLoading = true;
            kwError = null;
            kwCurrentPage = page;
        }
        else
        {
            nmLoading = true;
            nmError = null;
            nmCurrentPage = page;
        }

        try
        {
            var response = await Client.GetFromJsonAsync<RejectedEntityListResponse>(
                $"/api/rejected-entities?type={entityType}&page={page}&pageSize=50");
            if (response is not null)
            {
                if (entityType == "keyword")
                {
                    kwEvents = response.data;
                    kwTotal = response.total;
                    kwTotalPages = response.totalPages;
                }
                else
                {
                    nmEvents = response.data;
                    nmTotal = response.total;
                    nmTotalPages = response.totalPages;
                }
            }
        }
        catch (Exception ex)
        {
            if (entityType == "keyword")
            {
                kwError = $"Failed to load: {ex.Message}";
                kwEvents = null;
            }
            else
            {
                nmError = $"Failed to load: {ex.Message}";
                nmEvents = null;
            }
        }
        finally
        {
            if (entityType == "keyword")
                kwLoading = false;
            else
                nmLoading = false;
        }
    }

    private async Task LoadKwPage(int page) => await LoadRejectedPage("keyword", page);
    private async Task LoadNmPage(int page) => await LoadRejectedPage("investigator_name", page);

    // ============== NPI Enrichment Tab ==============

    private Dictionary<string, int>? enrichmentBreakdown;
    private bool enrichmentLoading;
    private string? enrichmentError;

    private int GetCount(string key) =>
        enrichmentBreakdown is not null && enrichmentBreakdown.TryGetValue(key, out var count) ? count : 0;

    private async Task LoadEnrichmentBreakdown()
    {
        enrichmentLoading = true;
        enrichmentError = null;
        try
        {
            enrichmentBreakdown = await Client.GetFromJsonAsync<Dictionary<string, int>>("/api/enrichment/breakdown");
        }
        catch (Exception ex)
        {
            enrichmentError = $"Failed to load: {ex.Message}";
            enrichmentBreakdown = null;
        }
        finally
        {
            enrichmentLoading = false;
        }
    }

    // ============== Shared ==============

    private static List<int?> GetPaginationRange(int current, int total, int maxVisible = 10)
    {
        var range = new List<int?>();
        if (total <= maxVisible)
        {
            for (int i = 1; i <= total; i++) range.Add(i);
            return range;
        }

        int half = maxVisible / 2;
        int start = Math.Max(1, current - half);
        int end = Math.Min(total, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        if (start > 1)
        {
            range.Add(1);
            if (start > 2) range.Add(null);
        }

        for (int i = start; i <= end; i++)
            range.Add(i);

        if (end < total)
        {
            if (end < total - 1) range.Add(null);
            range.Add(total);
        }

        return range;
    }

    private static string FormatDate(DateTime dt) =>
        dt.ToString("yyyy-MM-dd HH:mm");

    private static string TruncatePayload(string? data)
    {
        if (string.IsNullOrEmpty(data)) return "--";
        return data.Length > 50 ? data[..50] + "..." : data;
    }

    private static string TruncateText(string? text, int maxLen)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length > maxLen ? text[..maxLen] + "..." : text;
    }

    // ============== DTOs ==============

    private class DeadLetterItem
    {
        public int id { get; set; }
        public string? eventType { get; set; }
        public string? data { get; set; }
        public string? status { get; set; }
        public string? errorMessage { get; set; }
        public int retryCount { get; set; }
        public DateTime createdAt { get; set; }
        public DateTime? completedAt { get; set; }
    }

    private class DeadLetterListResponse
    {
        public List<DeadLetterItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class RejectedEntityItem
    {
        public int id { get; set; }
        public string? entityType { get; set; }
        public string? value { get; set; }
        public string? studyNctId { get; set; }
        public DateTime rejectedAt { get; set; }
    }

    private class RejectedEntityListResponse
    {
        public List<RejectedEntityItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }
}
