@page "/blog/{Slug}"
@inject BlogService BlogService
@attribute [StreamRendering]

@if (post is null)
{
    @if (notFound)
    {
        <div class="alert alert-warning mt-4">Post not found.</div>
    }
    else
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
            <li class="breadcrumb-item active">@post.Title</li>
        </ol>
    </nav>

    <h1>@post.Title</h1>
    <p class="text-muted">
        @post.Date.ToString("yyyy-MM-dd") &middot; @post.Category
        @foreach (var tag in post.Tags)
        {
            <span class="badge bg-secondary ms-1">@tag</span>
        }
    </p>

    <hr />

    <div class="blog-content">
        @((MarkupString)post.BodyHtml)
    </div>

    <hr />
    <a href="/blog" class="btn btn-outline-secondary">&larr; Back to Blog</a>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private BlogPostInfo? post;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        post = await BlogService.GetPostBySlugAsync(Slug);
        notFound = post is null;
    }
}
