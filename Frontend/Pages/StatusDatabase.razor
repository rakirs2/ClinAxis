@page "/status/database"
@using System.Net.Http.Json
@inject HttpClient Client
@inject NavigationManager Navigation

<h1>System Status</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link" href="/status">System Status</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="/status/database">Database Size</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/duration-trend">Duration Trend</a>
    </li>
</ul>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (data is null)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-6 d-flex flex-column">
            <div class="card text-bg-primary h-100" style="min-height: 130px">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h5 class="card-title">Total Database Rows</h5>
                    <p class="display-6 mb-0">@data.totalRowCount.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column">
            <div class="card text-bg-success h-100" style="min-height: 130px">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h5 class="card-title">Estimated Total Size</h5>
                    <p class="display-6 mb-0">@data.estimatedSizeGb GB</p>
                </div>
            </div>
        </div>
    </div>

    <h3>Table Row Counts</h3>
    <p class="text-muted">Sorted by row count descending.</p>

    @if (data.tables is { Count: > 0 })
    {
        var maxCount = data.tables.Max(t => t.rowCount);
        <table class="table table-sm table-striped" style="max-width: 100%">
            <thead>
                <tr>
                    <th>Table</th>
                    <th>Rows</th>
                    <th style="width: 40%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var table in data.tables)
                {
                    var pct = maxCount > 0 ? (double)table.rowCount / maxCount * 100 : 0;
                    var barClass = pct >= 75 ? "bg-danger" : pct >= 50 ? "bg-warning" : pct >= 25 ? "bg-info" : "bg-success";
                    <tr>
                        <td><code>@table.name</code></td>
                        <td class="text-end">@table.rowCount.ToString("N0")</td>
                        <td>
                            <div class="progress" style="height: 20px">
                                <div class="progress-bar @barClass"
                                     role="progressbar"
                                     style="width: @pct.ToString("F1")%"
                                     aria-valuenow="@table.rowCount"
                                     aria-valuemin="0"
                                     aria-valuemax="@maxCount">
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No table data available.</p>
    }
}

@code {
    private DatabaseSizeResponse? data;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            data = await Client.GetFromJsonAsync<DatabaseSizeResponse>("/api/database/size");
        }
        catch (Exception ex)
        {
            error = $"Failed to load database size data: {ex.Message}";
        }
    }

    private class DatabaseSizeResponse
    {
        public long totalRowCount { get; set; }
        public double estimatedSizeGb { get; set; }
        public List<TableRowItem>? tables { get; set; }
    }

    private class TableRowItem
    {
        public string name { get; set; } = string.Empty;
        public long rowCount { get; set; }
    }
}
