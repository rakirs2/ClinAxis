@page "/"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<h1>Advanced Study Search</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" href="/">Search</a>
    </li>
</ul>

<div class="card mb-4">
    <div class="card-header">
        <h5>Filter by 7 Dimensions</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Keyword (Title/NCT ID/Keywords)</label>
                <input value="@criteria.Keyword" @oninput="OnKeywordInput" class="form-control" placeholder="Search by title, NCT ID, or keyword" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <div class="filter-checkboxes">
                    @foreach (var status in statuses)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="status_@status" 
                                   @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                            <label class="form-check-label" for="status_@status">@status</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phase</label>
                <div class="filter-checkboxes">
                    @foreach (var phase in phases)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="phase_@phase" 
                                   @onchange="@((ChangeEventArgs e) => TogglePhase(phase, (bool)e.Value!))" />
                             <label class="form-check-label" for="phase_@phase">@PhaseHelpers.DisplayName(phase)</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Conditions (MeSH)</label>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <select class="form-select" @onchange="HandleBranchChange">
                            <option value="">-- All Categories --</option>
                            @foreach (var b in availableBranches)
                            {
                                <option value="@b.Prefix" selected="@(selectedBranch == b.Prefix)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control" placeholder="Search condition name..."
                               value="@conditionSearchText"
                               @oninput="OnConditionSearchInput" />
                        @if (filteredConditions.Count > 0 && conditionSearchText.Length > 0)
                        {
                            <ul class="list-group position-absolute" style="z-index: 1000; max-height: 200px; overflow-y: auto; width: calc(50% - 30px);">
                                @foreach (var c in filteredConditions.Take(20))
                                {
                                    <li class="list-group-item list-group-item-action" @onclick="() => AddCondition(c)" style="cursor: pointer; font-size: 0.9em;">
                                        @c
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                @if (criteria.Conditions.Count > 0)
                {
                    <div class="mb-2">
                        @foreach (var c in criteria.Conditions)
                        {
                            <span class="badge bg-info me-1" style="font-size: 0.85em;">
                                @c <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" @onclick="() => RemoveCondition(c)"></button>
                            </span>
                        }
                    </div>
                }
                @if (loadingMeshTree)
                {
                    <p class="text-muted"><small>Loading conditions...</small></p>
                }
                else
                {
                    <div class="mesh-tree" style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                        <div id="meshTreeContainer"></div>
                    </div>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger mt-2">@error</div>
                    }
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Enrollment Min</label>
                <input type="number" value="@criteria.EnrollmentMin" @oninput="OnEnrollmentMinInput" class="form-control" placeholder="Min enrollment" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Enrollment Max</label>
                <input type="number" value="@criteria.EnrollmentMax" @oninput="OnEnrollmentMaxInput" class="form-control" placeholder="Max enrollment" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Start Date From</label>
                <input type="date" value="@FormatDate(startDateFrom)" @oninput="OnStartDateFromInput" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Start Date To</label>
                <input type="date" value="@FormatDate(startDateTo)" @oninput="OnStartDateToInput" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-primary" @onclick="SearchStudies" disabled="@(loading || loadingMeshTree)">
                    @if (loading) { <span>Searching...</span> } else { <span>Search</span> }
                </button>
                <button class="btn btn-secondary ms-2" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (searchExecuted && studies is not null)
{
    @if (studies.Count == 0)
    {
        <p class="text-muted">No studies found matching your filters.</p>
    }
    else
    {
        <p class="text-muted">Showing @studies.Count of @total studies (Page @currentPage of @totalPages)</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>NCT ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Conditions</th>
                    <th>Phases</th>
                    <th>Enrollment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in studies)
                {
                    <tr>
                        <td><a href="/studies/@s.nctId">@s.nctId</a></td>
                        <td>@s.briefTitle</td>
                        <td><span class="badge bg-@StatusColor(s.overallStatus)">@s.overallStatus</span></td>
                        <td>@(s.conditions is not null ? string.Join(", ", s.conditions) : "")</td>
                        <td>@PhaseHelpers.DisplayPhases(s.phases ?? [])</td>
                        <td>@s.enrollmentCount</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in PaginationHelpers.GetPaginationRange(currentPage, totalPages))
                    {
                        if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@code {
    private SearchCriteria criteria = new();
    private List<StudySummary>? studies;
    private int currentPage = 1;
    private int pageSize = 10;
    private int total;
    private int totalPages;
    private bool loading;
    private bool loadingMeshTree;
    private bool searchExecuted;
    private string? error;

    // Filter dropdown values
    private List<string> statuses = new() { "RECRUITING", "ACTIVE", "COMPLETED", "WITHDRAWN", "SUSPENDED", "TERMINATED", "UNKNOWN" };
    private List<string> phases = new() { "EARLY_PHASE1", "PHASE1", "PHASE2", "PHASE3", "PHASE4", "NA" };
    private List<MeshTreeNode> meshTreeRoots = new();

    // Date filter bindings
    private DateTime? startDateFrom;
    private DateTime? startDateTo;

    // MeSH branch selection
    private string? selectedBranch;
    private static readonly List<BranchInfo> availableBranches = new()
    {
        new("A", "Anatomy"),
        new("B", "Organisms"),
        new("C", "Diseases"),
        new("D", "Chemicals and Drugs"),
        new("E", "Techniques and Equipment"),
        new("F", "Psychiatry and Psychology"),
        new("G", "Phenomena and Processes"),
        new("H", "Disciplines and Occupations"),
        new("I", "Anthropology and Sociology"),
        new("J", "Technology and Industry"),
        new("K", "Humanities"),
        new("L", "Information Science"),
        new("M", "Named Groups"),
        new("N", "Health Care"),
        new("V", "Publication Characteristics"),
        new("Z", "Geographicals"),
    };

    // Condition name autocomplete
    private List<string> allConditions = new();
    private string conditionSearchText = "";
    private List<string> filteredConditions = new();
    private bool _conditionsLoaded;

    private bool _treeRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (meshTreeRoots.Count > 0 && !_treeRendered)
        {
            _treeRendered = true;
            await JS.InvokeVoidAsync("meshTree.render", "meshTreeContainer", meshTreeRoots, criteria.MeshTreePrefixes);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (urlCriteria, urlPage) = SearchUrlParser.Parse(NavigationManager.Uri);
        criteria = urlCriteria;
        currentPage = urlPage;

        await LoadAllConditions();
        _ = LoadMeshTree(null);

        if (HasActiveFilters(urlCriteria) || urlPage > 1)
        {
            await LoadPage(urlPage);
        }
    }

    private static bool HasActiveFilters(SearchCriteria c)
    {
        return !string.IsNullOrWhiteSpace(c.Keyword)
            || c.Statuses.Count > 0
            || c.Phases.Count > 0
            || c.Conditions.Count > 0
            || c.MeshTreePrefixes.Count > 0
            || c.EnrollmentMin.HasValue
            || c.EnrollmentMax.HasValue
            || c.StartDateFrom.HasValue
            || c.StartDateTo.HasValue;
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToString("yyyy-MM-dd") ?? "";
    }

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedSearch()
    {
        _debounceCts?.Cancel();
        var cts = _debounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
            await SearchStudies();
        }
        catch (TaskCanceledException)
        {
            // A newer keystroke superseded this one; its own debounce will search.
        }
    }

    private async Task OnKeywordInput(ChangeEventArgs e)
    {
        criteria.Keyword = e.Value?.ToString();
        await DebouncedSearch();
    }

    private async Task OnEnrollmentMinInput(ChangeEventArgs e)
    {
        criteria.EnrollmentMin = int.TryParse(e.Value?.ToString(), out var value) ? value : null;
        await DebouncedSearch();
    }

    private async Task OnEnrollmentMaxInput(ChangeEventArgs e)
    {
        criteria.EnrollmentMax = int.TryParse(e.Value?.ToString(), out var value) ? value : null;
        await DebouncedSearch();
    }

    private async Task OnStartDateFromInput(ChangeEventArgs e)
    {
        startDateFrom = DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var value)
            ? value
            : null;
        criteria.StartDateFrom = startDateFrom;
        await DebouncedSearch();
    }

    private async Task OnStartDateToInput(ChangeEventArgs e)
    {
        startDateTo = DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var value)
            ? value
            : null;
        criteria.StartDateTo = startDateTo;
        await DebouncedSearch();
    }

    private async Task LoadAllConditions()
    {
        if (_conditionsLoaded) return;
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            allConditions = await client.GetFromJsonAsync<List<string>>("/api/distinct-conditions") ?? new();
            _conditionsLoaded = true;
            if (!string.IsNullOrEmpty(conditionSearchText))
            {
                filteredConditions = SearchConditionFilter.Filter(allConditions, conditionSearchText);
            }
        }
        catch
        {
            // Non-critical; autocomplete will just be unavailable
        }
    }

    private async Task LoadMeshTree(string? branch)
    {
        loadingMeshTree = true;
        error = null;
        _treeRendered = false;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var branchParam = branch ?? "";
            var url = string.IsNullOrEmpty(branchParam)
                ? "/api/mesh-tree?minStudyCount=1&depth=5"
                : $"/api/mesh-tree?branch={branchParam}&minStudyCount=1&depth=5";
            var response = await client.GetFromJsonAsync<MeshTreeBranchResponse>(url);
            if (response?.Nodes is not null)
            {
                meshTreeRoots = ConvertBranchNodes(response.Nodes);
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load conditions: {ex.Message}";
        }
        finally
        {
            loadingMeshTree = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static List<MeshTreeNode> ConvertBranchNodes(List<MeshTreeBranchNode> nodes)
    {
        return nodes.Select(n => new MeshTreeNode
        {
            TreeNumber = n.TreeNumber,
            Name = n.Name,
            StudyCount = n.StudyCount,
            HasChildren = n.HasChildren,
            Children = n.Children is { Count: > 0 } ? ConvertBranchNodes(n.Children) : null,
        }).ToList();
    }

    private async Task HandleBranchChange(ChangeEventArgs e)
    {
        selectedBranch = e.Value?.ToString();
        criteria.MeshTreePrefixes.Clear();
        await JS.InvokeVoidAsync("meshTree.clear", "meshTreeContainer");
        await LoadMeshTree(selectedBranch);
    }

    private void OnConditionSearchInput(ChangeEventArgs e)
    {
        conditionSearchText = e.Value?.ToString() ?? "";
        filteredConditions = SearchConditionFilter.Filter(allConditions, conditionSearchText);
    }

    private async Task AddCondition(string condition)
    {
        if (!criteria.Conditions.Contains(condition))
        {
            criteria.Conditions.Add(condition);
        }
        conditionSearchText = "";
        filteredConditions.Clear();
        await SearchStudies();
    }

    private async Task RemoveCondition(string condition)
    {
        criteria.Conditions.Remove(condition);
        await SearchStudies();
    }

    private async Task ToggleStatus(string status, bool isChecked)
    {
        if (isChecked)
        {
            if (!criteria.Statuses.Contains(status))
                criteria.Statuses.Add(status);
        }
        else
        {
            criteria.Statuses.Remove(status);
        }
        await SearchStudies();
    }

    private async Task TogglePhase(string phase, bool isChecked)
    {
        if (isChecked)
        {
            if (!criteria.Phases.Contains(phase))
                criteria.Phases.Add(phase);
        }
        else
        {
            criteria.Phases.Remove(phase);
        }
        await SearchStudies();
    }

    private async Task SearchStudies()
    {
        var selected = await JS.InvokeAsync<string[]>("meshTree.getSelected", "meshTreeContainer");
        criteria.MeshTreePrefixes = selected?.ToList() ?? [];

        criteria.StartDateFrom = startDateFrom;
        criteria.StartDateTo = startDateTo;

        await LoadPage(1);
    }

    private async Task GoToPage(int page)
    {
        await LoadPage(page);
    }

    private async Task LoadPage(int page)
    {
        loading = true;
        error = null;
        currentPage = page;
        searchExecuted = true;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");

            var queryString = SearchQueryBuilder.BuildStudiesQuery(page, pageSize, criteria);
            var response = await client.GetFromJsonAsync<StudyListResponse>($"/api/studies?{queryString}");
            
            if (response is not null)
            {
                studies = response.data;
                total = response.total;
                totalPages = response.totalPages;
                NavigationManager.NavigateTo($"/?{queryString}", replace: true);
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to search studies: {ex.Message}";
            studies = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ResetFilters()
    {
        criteria = new();
        selectedBranch = null;
        conditionSearchText = "";
        filteredConditions.Clear();
        startDateFrom = null;
        startDateTo = null;
        studies = null;
        searchExecuted = false;
        error = null;
        await JS.InvokeVoidAsync("meshTree.clear", "meshTreeContainer");
        await LoadMeshTree(null);

        NavigationManager.NavigateTo("/", replace: true);
    }

    private static string StatusColor(string? status) => status switch
    {
        "ACTIVE" or "RECRUITING" => "success",
        "COMPLETED" => "primary",
        "UNKNOWN" or "WITHDRAWN" => "secondary",
        "TERMINATED" or "SUSPENDED" => "danger",
        _ => "warning"
    };

    private class StudyListResponse
    {
        public List<StudySummary>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class StudySummary
    {
        public string? nctId { get; set; }
        public string? briefTitle { get; set; }
        public string? overallStatus { get; set; }
        public List<string>? conditions { get; set; }
        public List<string>? phases { get; set; }
        public int? enrollmentCount { get; set; }
    }

    private class MeshTreeResponse { public string? branch { get; set; } public List<MeshTreeNode>? nodes { get; set; } }

    private record BranchInfo(string Prefix, string Name);
}
