@page "/"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<h1>Advanced Study Search</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" href="/">Search</a>
    </li>
</ul>

<div class="card mb-4">
    <div class="card-header">
        <h5>Filter by 7 Dimensions</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Keyword (Title/NCT ID)</label>
                <input @bind="criteria.Keyword" class="form-control" placeholder="Search by title or NCT ID" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <div class="filter-checkboxes">
                    @foreach (var status in statuses)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="status_@status" 
                                   @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                            <label class="form-check-label" for="status_@status">@status</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phase</label>
                <div class="filter-checkboxes">
                    @foreach (var phase in phases)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="phase_@phase" 
                                   @onchange="@((ChangeEventArgs e) => TogglePhase(phase, (bool)e.Value!))" />
                             <label class="form-check-label" for="phase_@phase">@PhaseHelpers.DisplayName(phase)</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Conditions (MeSH)</label>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <select class="form-select" @onchange="HandleBranchChange">
                            <option value="">-- All Categories --</option>
                            @foreach (var b in availableBranches)
                            {
                                <option value="@b.Prefix" selected="@(selectedBranch == b.Prefix)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control" placeholder="Search condition name..."
                               value="@conditionSearchText"
                               @oninput="OnConditionSearchInput" />
                        @if (filteredConditions.Count > 0 && conditionSearchText.Length > 0)
                        {
                            <ul class="list-group position-absolute" style="z-index: 1000; max-height: 200px; overflow-y: auto; width: calc(50% - 30px);">
                                @foreach (var c in filteredConditions.Take(20))
                                {
                                    <li class="list-group-item list-group-item-action" @onclick="() => AddCondition(c)" style="cursor: pointer; font-size: 0.9em;">
                                        @c
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                @if (criteria.Conditions.Count > 0)
                {
                    <div class="mb-2">
                        @foreach (var c in criteria.Conditions)
                        {
                            <span class="badge bg-info me-1" style="font-size: 0.85em;">
                                @c <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" @onclick="() => RemoveCondition(c)"></button>
                            </span>
                        }
                    </div>
                }
                @if (loadingMeshTree)
                {
                    <p class="text-muted"><small>Loading conditions...</small></p>
                }
                else
                {
                    <div class="mesh-tree" style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                        <div id="meshTreeContainer"></div>
                    </div>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger mt-2">@error</div>
                    }
                }
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-md-12">
                <label class="form-label">Location Mode</label>
                <div>
                    <label class="me-3">
                        <input type="radio" name="locationMode" checked="@_useMeshLocation" @onchange="() => SwitchLocationMode(true)" />
                        MeSH Geography (normalized)
                    </label>
                    <label>
                        <input type="radio" name="locationMode" checked="@(!_useMeshLocation)" @onchange="() => SwitchLocationMode(false)" />
                        Raw Locations (distinct DB values)
                    </label>
                </div>
            </div>
        </div>

        @if (_useMeshLocation)
        {
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Country (MeSH)</label>
                    <select class="form-select" @onchange="HandleMeshCountryChange">
                        <option value="">-- Select Country --</option>
                        @foreach (var loc in availableMeshCountries)
                        {
                            <option value="@loc.treeNumber">@loc.name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">State (MeSH)</label>
                    <select class="form-select" @onchange="HandleMeshStateChange" disabled="@(_selectedMeshCountry == null)">
                        <option value="">-- Select State --</option>
                        @foreach (var loc in availableMeshStates)
                        {
                            <option value="@loc.treeNumber">@loc.name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">City</label>
                    <select class="form-select" @onchange="HandleMeshCityChange" disabled="@(_selectedMeshState == null)">
                        <option value="">-- Select City --</option>
                        @foreach (var city in availableCities.OrderBy(c => c))
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <label class="form-label">Facility</label>
                    @if (availableFacilities.Count == 0)
                    {
                        <p class="text-muted"><small>Select city to see facilities</small></p>
                    }
                    else
                    {
                        <div class="filter-checkboxes" style="max-height: 150px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                            @foreach (var facility in availableFacilities.OrderBy(f => f))
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="facility_@facility" 
                                           @onchange="@((ChangeEventArgs e) => ToggleFacility(facility, (bool)e.Value!))" />
                                    <label class="form-check-label" for="facility_@facility">@facility</label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Country</label>
                    <select class="form-select" @onchange="HandleRawCountryChange">
                        <option value="">-- Select Country --</option>
                        @foreach (var c in availableRawCountries.OrderBy(c => c))
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">State</label>
                    <select class="form-select" @onchange="HandleRawStateChange" disabled="@(string.IsNullOrEmpty(_selectedRawCountry))">
                        <option value="">-- Select State --</option>
                        @foreach (var s in availableRawStates.OrderBy(s => s))
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">City</label>
                    <select class="form-select" @onchange="HandleRawCityChange" disabled="@(string.IsNullOrEmpty(_selectedRawState))">
                        <option value="">-- Select City --</option>
                        @foreach (var city in availableRawCities.OrderBy(c => c))
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <label class="form-label">Facility</label>
                    @if (availableRawFacilities.Count == 0)
                    {
                        <p class="text-muted"><small>Select city to see facilities</small></p>
                    }
                    else
                    {
                        <div class="filter-checkboxes" style="max-height: 150px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                            @foreach (var facility in availableRawFacilities.OrderBy(f => f))
                            {
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="rawfacility_@facility" 
                                           @onchange="@((ChangeEventArgs e) => ToggleRawFacility(facility, (bool)e.Value!))" />
                                    <label class="form-check-label" for="rawfacility_@facility">@facility</label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Enrollment Min</label>
                <input type="number" @bind="criteria.EnrollmentMin" class="form-control" placeholder="Min enrollment" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Enrollment Max</label>
                <input type="number" @bind="criteria.EnrollmentMax" class="form-control" placeholder="Max enrollment" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Start Date From</label>
                <input type="date" @bind="startDateFrom" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Start Date To</label>
                <input type="date" @bind="startDateTo" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-primary" @onclick="SearchStudies" disabled="@(loading || loadingMeshTree)">
                    @if (loading) { <span>Searching...</span> } else { <span>Search</span> }
                </button>
                <button class="btn btn-secondary ms-2" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (searchExecuted && studies is not null)
{
    @if (studies.Count == 0)
    {
        <p class="text-muted">No studies found matching your filters.</p>
    }
    else
    {
        <p class="text-muted">Showing @studies.Count of @total studies (Page @currentPage of @totalPages)</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>NCT ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Conditions</th>
                    <th>Phases</th>
                    <th>Enrollment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in studies)
                {
                    <tr>
                        <td><a href="/studies/@s.nctId">@s.nctId</a></td>
                        <td>@s.briefTitle</td>
                        <td><span class="badge bg-@StatusColor(s.overallStatus)">@s.overallStatus</span></td>
                        <td>@(s.conditions is not null ? string.Join(", ", s.conditions) : "")</td>
                        <td>@PhaseHelpers.DisplayPhases(s.phases ?? [])</td>
                        <td>@s.enrollmentCount</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in GetPaginationRange(currentPage, totalPages))
                    {
                        if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@code {
    private SearchCriteria criteria = new();
    private List<StudySummary>? studies;
    private int currentPage = 1;
    private int pageSize = 10;
    private int total;
    private int totalPages;
    private bool loading;
    private bool loadingMeshTree;
    private bool searchExecuted;
    private string? error;

    // Filter dropdown values
    private List<string> statuses = new() { "RECRUITING", "ACTIVE", "COMPLETED", "WITHDRAWN", "SUSPENDED", "TERMINATED", "UNKNOWN" };
    private List<string> phases = new() { "EARLY_PHASE1", "PHASE1", "PHASE2", "PHASE3", "PHASE4", "NA" };
    private List<MeshTreeNode> meshTreeRoots = new();
    private bool _useMeshLocation = true;

    // MeSH location mode
    private List<LocationMeshNode> availableMeshCountries = new();
    private List<LocationMeshNode> availableMeshStates = new();
    private string? _selectedMeshCountry;
    private string? _selectedMeshState;

    // Raw location mode
    private List<string> availableRawCountries = new();
    private List<string> availableRawStates = new();
    private List<string> availableRawCities = new();
    private List<string> availableRawFacilities = new();
    private string? _selectedRawCountry;
    private string? _selectedRawState;
    private string? _selectedRawCity;
    private List<string> _selectedRawFacilities = new();

    // Shared city/facility (MeSH mode uses these too)
    private List<string> availableCities = new();
    private List<string> availableFacilities = new();
    private string? selectedCity;

    // Date filter bindings
    private DateTime? startDateFrom;
    private DateTime? startDateTo;

    // MeSH branch selection
    private string? selectedBranch;
    private static readonly List<BranchInfo> availableBranches = new()
    {
        new("A", "Anatomy"),
        new("B", "Organisms"),
        new("C", "Diseases"),
        new("D", "Chemicals and Drugs"),
        new("E", "Techniques and Equipment"),
        new("F", "Psychiatry and Psychology"),
        new("G", "Phenomena and Processes"),
        new("H", "Disciplines and Occupations"),
        new("I", "Anthropology and Sociology"),
        new("J", "Technology and Industry"),
        new("K", "Humanities"),
        new("L", "Information Science"),
        new("M", "Named Groups"),
        new("N", "Health Care"),
        new("V", "Publication Characteristics"),
        new("Z", "Geographicals"),
    };

    // Condition name autocomplete
    private List<string> allConditions = new();
    private string conditionSearchText = "";
    private List<string> filteredConditions = new();
    private bool _conditionsLoaded;

    private bool _treeRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (meshTreeRoots.Count > 0 && !_treeRendered)
        {
            _treeRendered = true;
            await JS.InvokeVoidAsync("meshTree.render", "meshTreeContainer", meshTreeRoots, criteria.MeshTreePrefixes);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadMeshTree(null), LoadAllConditions(), LoadMeshCountries());
    }

    private async Task LoadAllConditions()
    {
        if (_conditionsLoaded) return;
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            allConditions = await client.GetFromJsonAsync<List<string>>("/api/distinct-conditions") ?? new();
            _conditionsLoaded = true;
        }
        catch
        {
            // Non-critical; autocomplete will just be unavailable
        }
    }

    private async Task LoadMeshTree(string? branch)
    {
        loadingMeshTree = true;
        error = null;
        _treeRendered = false;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var branchParam = branch ?? "";
            var url = string.IsNullOrEmpty(branchParam)
                ? "/api/mesh-tree?minStudyCount=1&depth=5"
                : $"/api/mesh-tree?branch={branchParam}&minStudyCount=1&depth=5";
            var response = await client.GetFromJsonAsync<MeshTreeBranchResponse>(url);
            if (response?.Nodes is not null)
            {
                meshTreeRoots = ConvertBranchNodes(response.Nodes);
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load conditions: {ex.Message}";
        }
        finally
        {
            loadingMeshTree = false;
        }
    }

    private static List<MeshTreeNode> ConvertBranchNodes(List<MeshTreeBranchNode> nodes)
    {
        return nodes.Select(n => new MeshTreeNode
        {
            TreeNumber = n.TreeNumber,
            Name = n.Name,
            StudyCount = n.StudyCount,
            HasChildren = n.HasChildren,
            Children = n.Children is { Count: > 0 } ? ConvertBranchNodes(n.Children) : null,
        }).ToList();
    }

    private async Task HandleBranchChange(ChangeEventArgs e)
    {
        selectedBranch = e.Value?.ToString();
        criteria.MeshTreePrefixes.Clear();
        await JS.InvokeVoidAsync("meshTree.clear", "meshTreeContainer");
        await LoadMeshTree(selectedBranch);
    }

    private void OnConditionSearchInput(ChangeEventArgs e)
    {
        conditionSearchText = e.Value?.ToString() ?? "";
        if (conditionSearchText.Length > 0)
        {
            filteredConditions = allConditions
                .Where(c => c.Contains(conditionSearchText, StringComparison.OrdinalIgnoreCase))
                .Take(20)
                .ToList();
        }
        else
        {
            filteredConditions.Clear();
        }
    }

    private void AddCondition(string condition)
    {
        if (!criteria.Conditions.Contains(condition))
        {
            criteria.Conditions.Add(condition);
        }
        conditionSearchText = "";
        filteredConditions.Clear();
    }

    private void RemoveCondition(string condition)
    {
        criteria.Conditions.Remove(condition);
    }

    private void SwitchLocationMode(bool useMesh)
    {
        _useMeshLocation = useMesh;
        _selectedMeshCountry = null;
        _selectedMeshState = null;
        _selectedRawCountry = null;
        _selectedRawState = null;
        _selectedRawCity = null;
        _selectedRawFacilities.Clear();
        selectedCity = null;
        availableMeshCountries.Clear();
        availableMeshStates.Clear();
        availableRawCountries.Clear();
        availableRawStates.Clear();
        availableRawCities.Clear();
        availableRawFacilities.Clear();
        availableCities.Clear();
        availableFacilities.Clear();
        criteria.LocationMeshTreePrefixes.Clear();
        criteria.Countries = null;
        criteria.States = null;
        criteria.Cities = Array.Empty<string>();
        criteria.Facilities = null;

        if (_useMeshLocation)
        {
            _ = LoadMeshCountries();
        }
        else
        {
            _ = LoadRawCountries();
        }
    }

    private async Task LoadMeshCountries()
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<MeshTreeResponse>("/api/mesh-tree?branch=Z&depth=1");
            availableMeshCountries = response?.nodes?.Select(n => new LocationMeshNode { treeNumber = n.TreeNumber, name = n.Name }).ToList() ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load countries: {ex.Message}";
        }
    }

    private async Task HandleMeshCountryChange(ChangeEventArgs e)
    {
        _selectedMeshCountry = e.Value?.ToString();
        _selectedMeshState = null;
        selectedCity = null;
        availableMeshStates.Clear();
        availableCities.Clear();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(_selectedMeshCountry))
        {
            await LoadMeshStates(_selectedMeshCountry);
        }

        criteria.LocationMeshTreePrefixes = string.IsNullOrEmpty(_selectedMeshCountry) ? new() : new() { _selectedMeshCountry };
    }

    private async Task LoadMeshStates(string treeNumber)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<MeshTreeResponse>($"/api/mesh-tree?branch={Uri.EscapeDataString(treeNumber)}&depth=1");
            availableMeshStates = response?.nodes?.Select(n => new LocationMeshNode { treeNumber = n.TreeNumber, name = n.Name }).ToList() ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load states: {ex.Message}";
        }
    }

    private async Task HandleMeshStateChange(ChangeEventArgs e)
    {
        _selectedMeshState = e.Value?.ToString();
        selectedCity = null;
        availableCities.Clear();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(_selectedMeshState) && !string.IsNullOrEmpty(_selectedMeshCountry))
        {
            await LoadCitiesByState(_selectedMeshCountry ?? "", _selectedMeshState ?? "");
        }

        criteria.LocationMeshTreePrefixes = _selectedMeshCountry is not null ? new() { _selectedMeshCountry } : new();
        if (!string.IsNullOrEmpty(_selectedMeshState))
        {
            criteria.LocationMeshTreePrefixes.Add(_selectedMeshState);
        }
    }

    private async Task HandleMeshCityChange(ChangeEventArgs e)
    {
        selectedCity = e.Value?.ToString();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(selectedCity) && !string.IsNullOrEmpty(_selectedMeshCountry) && !string.IsNullOrEmpty(_selectedMeshState))
        {
            await LoadFacilitiesByCity(_selectedMeshCountry, _selectedMeshState, selectedCity);
        }

        criteria.Cities = string.IsNullOrEmpty(selectedCity) ? Array.Empty<string>() : new[] { selectedCity };
    }

    private async Task LoadRawCountries()
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>("/api/distinct-locations");
            availableRawCountries = response?.countries ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load countries: {ex.Message}";
        }
    }

    private async Task HandleRawCountryChange(ChangeEventArgs e)
    {
        _selectedRawCountry = e.Value?.ToString();
        _selectedRawState = null;
        _selectedRawCity = null;
        _selectedRawFacilities.Clear();
        availableRawStates.Clear();
        availableRawCities.Clear();
        availableRawFacilities.Clear();
        criteria.Countries = string.IsNullOrEmpty(_selectedRawCountry) ? null : new List<string> { _selectedRawCountry };
        criteria.States = null;
        criteria.Cities = Array.Empty<string>();
        criteria.Facilities = null;

        if (!string.IsNullOrEmpty(_selectedRawCountry))
        {
            await LoadRawStates(_selectedRawCountry);
        }
    }

    private async Task LoadRawStates(string country)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>($"/api/distinct-locations?country={Uri.EscapeDataString(country)}");
            availableRawStates = response?.states ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load states: {ex.Message}";
        }
    }

    private async Task HandleRawStateChange(ChangeEventArgs e)
    {
        _selectedRawState = e.Value?.ToString();
        _selectedRawCity = null;
        _selectedRawFacilities.Clear();
        availableRawCities.Clear();
        availableRawFacilities.Clear();
        criteria.States = string.IsNullOrEmpty(_selectedRawState) ? null : new List<string> { _selectedRawState };
        criteria.Cities = Array.Empty<string>();
        criteria.Facilities = null;

        if (!string.IsNullOrEmpty(_selectedRawState) && !string.IsNullOrEmpty(_selectedRawCountry))
        {
            await LoadRawCities(_selectedRawCountry, _selectedRawState);
        }
    }

    private async Task LoadRawCities(string country, string state)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>(
                $"/api/distinct-locations?country={Uri.EscapeDataString(country)}&state={Uri.EscapeDataString(state)}");
            availableRawCities = response?.cities ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load cities: {ex.Message}";
        }
    }

    private async Task HandleRawCityChange(ChangeEventArgs e)
    {
        _selectedRawCity = e.Value?.ToString();
        availableRawFacilities.Clear();
        criteria.Cities = string.IsNullOrEmpty(_selectedRawCity) ? Array.Empty<string>() : new[] { _selectedRawCity };
        criteria.Facilities = null;

        if (!string.IsNullOrEmpty(_selectedRawCity) && !string.IsNullOrEmpty(_selectedRawCountry) && !string.IsNullOrEmpty(_selectedRawState))
        {
            await LoadRawFacilities(_selectedRawCountry, _selectedRawState, _selectedRawCity);
        }
    }

    private async Task LoadRawFacilities(string country, string state, string city)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
