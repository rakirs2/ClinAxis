@page "/"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpClientFactory

<h1>Advanced Study Search</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" href="/">Search</a>
    </li>
</ul>

<div class="card mb-4">
    <div class="card-header">
        <h5>Filter by 7 Dimensions</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Keyword (Title/NCT ID)</label>
                <input @bind="criteria.Keyword" class="form-control" placeholder="Search by title or NCT ID" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <div class="filter-checkboxes">
                    @foreach (var status in statuses)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="status_@status" 
                                   @onchange="@((ChangeEventArgs e) => ToggleStatus(status, (bool)e.Value!))" />
                            <label class="form-check-label" for="status_@status">@status</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Phase</label>
                <div class="filter-checkboxes">
                    @foreach (var phase in phases)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="phase_@phase" 
                                   @onchange="@((ChangeEventArgs e) => TogglePhase(phase, (bool)e.Value!))" />
                             <label class="form-check-label" for="phase_@phase">@PhaseHelpers.DisplayName(phase)</label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Diseases (MeSH)</label>
                @if (loadingMeshTree)
                {
                    <p class="text-muted"><small>Loading conditions...</small></p>
                }
                else
                {
                        <div class="mesh-tree" style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                        <details open>
                            <summary style="cursor:pointer;font-weight:500;">Diseases</summary>
                            <div style="margin-top:8px;">
                                <MeshTreeBranch Nodes="meshTreeRoots" SelectedTreeNumbers="criteria.MeshTreePrefixes" OnToggle="HandleMeshToggle" />
                            </div>
                        </details>
                    </div>
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Country</label>
                @if (loadingMeshTree)
                {
                    <p class="text-muted"><small>Loading locations...</small></p>
                }
                else
                {
                    <select class="form-select" @onchange="HandleCountryChange">
                        <option value="">-- Select Country --</option>
                        @foreach (var country in availableCountries.OrderBy(c => c))
                        {
                            <option value="@country">@country</option>
                        }
                    </select>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">State</label>
                <select class="form-select" @onchange="HandleStateChange" disabled="@(selectedCountry == null)">
                    <option value="">-- Select State --</option>
                    @foreach (var state in availableStates.OrderBy(s => s))
                    {
                        <option value="@state">@state</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">City</label>
                <select class="form-select" @onchange="HandleCityChange" disabled="@(selectedState == null)">
                    <option value="">-- Select City --</option>
                    @foreach (var city in availableCities.OrderBy(c => c))
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Facility</label>
                @if (availableFacilities.Count == 0)
                {
                    <p class="text-muted"><small>Select city to see facilities</small></p>
                }
                else
                {
                    <div class="filter-checkboxes" style="max-height: 150px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                        @foreach (var facility in availableFacilities.OrderBy(f => f))
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="facility_@facility" 
                                       @onchange="@((ChangeEventArgs e) => ToggleFacility(facility, (bool)e.Value!))" />
                                <label class="form-check-label" for="facility_@facility">@facility</label>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Enrollment Min</label>
                <input type="number" @bind="criteria.EnrollmentMin" class="form-control" placeholder="Min enrollment" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Enrollment Max</label>
                <input type="number" @bind="criteria.EnrollmentMax" class="form-control" placeholder="Max enrollment" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Start Date From</label>
                <input type="date" @bind="startDateFrom" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Start Date To</label>
                <input type="date" @bind="startDateTo" @bind:format="yyyy-MM-dd" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <button class="btn btn-primary" @onclick="SearchStudies" disabled="@(loading || loadingMeshTree)">
                    @if (loading) { <span>Searching...</span> } else { <span>Search</span> }
                </button>
                <button class="btn btn-secondary ms-2" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (searchExecuted && studies is not null)
{
    @if (studies.Count == 0)
    {
        <p class="text-muted">No studies found matching your filters.</p>
    }
    else
    {
        <p class="text-muted">Showing @studies.Count of @total studies (Page @currentPage of @totalPages)</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>NCT ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Conditions</th>
                    <th>Phases</th>
                    <th>Enrollment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in studies)
                {
                    <tr>
                        <td><a href="/studies/@s.nctId">@s.nctId</a></td>
                        <td>@s.briefTitle</td>
                        <td><span class="badge bg-@StatusColor(s.overallStatus)">@s.overallStatus</span></td>
                        <td>@(s.conditions is not null ? string.Join(", ", s.conditions) : "")</td>
                        <td>@PhaseHelpers.DisplayPhases(s.phases ?? [])</td>
                        <td>@s.enrollmentCount</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                    </li>
                    @foreach (var p in GetPaginationRange(currentPage, totalPages))
                    {
                        if (p is null)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p.Value)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    }
}

@code {
    private SearchCriteria criteria = new();
    private List<StudySummary>? studies;
    private int currentPage = 1;
    private int pageSize = 10;
    private int total;
    private int totalPages;
    private bool loading;
    private bool loadingMeshTree;
    private bool searchExecuted;
    private string? error;

    // Filter dropdown values
    private List<string> statuses = new() { "RECRUITING", "ACTIVE", "COMPLETED", "WITHDRAWN", "SUSPENDED", "TERMINATED", "UNKNOWN" };
    private List<string> phases = new() { "EARLY_PHASE1", "PHASE1", "PHASE2", "PHASE3", "PHASE4", "NA" };
    private List<MeshTreeNode> meshTreeRoots = new();
    private List<string> availableCountries = new();
    private List<string> availableStates = new();
    private List<string> availableCities = new();
    private List<string> availableFacilities = new();

    // Selected location filters
    private string? selectedCountry;
    private string? selectedState;
    private string? selectedCity;

    // Date filter bindings
    private DateTime? startDateFrom;
    private DateTime? startDateTo;

    protected override async Task OnInitializedAsync()
    {
        await LoadMeshTree();
    }

    private async Task LoadMeshTree()
    {
        loadingMeshTree = true;
        error = null;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<MeshTreeBranchResponse>("/api/mesh-tree?branch=C&minStudyCount=1&depth=5");
            if (response?.Nodes is not null)
            {
                meshTreeRoots = ConvertBranchNodes(response.Nodes);
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load conditions: {ex.Message}";
        }
        finally
        {
            loadingMeshTree = false;
        }
    }

    private static List<MeshTreeNode> ConvertBranchNodes(List<MeshTreeBranchNode> nodes)
    {
        return nodes.Select(n => new MeshTreeNode
        {
            TreeNumber = n.TreeNumber,
            Name = n.Name,
            StudyCount = n.StudyCount,
            HasChildren = n.HasChildren,
            Children = n.Children is { Count: > 0 } ? ConvertBranchNodes(n.Children) : null,
        }).ToList();
    }

    private void HandleMeshToggle((MeshTreeNode node, bool isChecked) args)
    {
        if (args.isChecked)
        {
            if (!criteria.MeshTreePrefixes.Contains(args.node.TreeNumber))
                criteria.MeshTreePrefixes.Add(args.node.TreeNumber);
        }
        else
        {
            criteria.MeshTreePrefixes.Remove(args.node.TreeNumber);
        }
    }

    private async Task HandleCountryChange(ChangeEventArgs e)
    {
        selectedCountry = e.Value?.ToString();
        selectedState = null;
        selectedCity = null;
        availableStates.Clear();
        availableCities.Clear();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(selectedCountry))
        {
            await LoadStatesByCountry(selectedCountry);
        }

        criteria.Countries = string.IsNullOrEmpty(selectedCountry) ? new[] { "" } : new[] { selectedCountry };
    }

    private async Task LoadStatesByCountry(string country)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>($"/api/distinct-locations?country={Uri.EscapeDataString(country)}");
            availableStates = response?.states ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load states: {ex.Message}";
        }
    }

    private async Task HandleStateChange(ChangeEventArgs e)
    {
        selectedState = e.Value?.ToString();
        selectedCity = null;
        availableCities.Clear();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(selectedState) && !string.IsNullOrEmpty(selectedCountry))
        {
            await LoadCitiesByState(selectedCountry, selectedState);
        }

        criteria.States = string.IsNullOrEmpty(selectedState) ? Array.Empty<string>() : new[] { selectedState };
    }

    private async Task LoadCitiesByState(string country, string state)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>(
                $"/api/distinct-locations?country={Uri.EscapeDataString(country)}&state={Uri.EscapeDataString(state)}");
            availableCities = response?.cities ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load cities: {ex.Message}";
        }
    }

    private async Task HandleCityChange(ChangeEventArgs e)
    {
        selectedCity = e.Value?.ToString();
        availableFacilities.Clear();

        if (!string.IsNullOrEmpty(selectedCity) && !string.IsNullOrEmpty(selectedCountry) && !string.IsNullOrEmpty(selectedState))
        {
            await LoadFacilitiesByCity(selectedCountry, selectedState, selectedCity);
        }

        criteria.Cities = string.IsNullOrEmpty(selectedCity) ? Array.Empty<string>() : new[] { selectedCity };
    }

    private async Task LoadFacilitiesByCity(string country, string state, string city)
    {
        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            var response = await client.GetFromJsonAsync<LocationsResponse>(
                $"/api/distinct-locations?country={Uri.EscapeDataString(country)}&state={Uri.EscapeDataString(state)}&city={Uri.EscapeDataString(city)}");
            availableFacilities = response?.facilities ?? new();
        }
        catch (Exception ex)
        {
            error = $"Failed to load facilities: {ex.Message}";
        }
    }

    private void ToggleStatus(string status, bool isChecked)
    {
        if (isChecked)
        {
            if (!criteria.Statuses.Contains(status))
                criteria.Statuses.Add(status);
        }
        else
        {
            criteria.Statuses.Remove(status);
        }
    }

    private void TogglePhase(string phase, bool isChecked)
    {
        if (isChecked)
        {
            if (!criteria.Phases.Contains(phase))
                criteria.Phases.Add(phase);
        }
        else
        {
            criteria.Phases.Remove(phase);
        }
    }

    private void ToggleFacility(string facility, bool isChecked)
    {
        if (isChecked)
        {
            if (!criteria.Facilities.Contains(facility))
                criteria.Facilities.Add(facility);
        }
        else
        {
            criteria.Facilities.Remove(facility);
        }
    }

    private async Task SearchStudies()
    {
        // Update date range from DateTime inputs
        criteria.StartDateFrom = startDateFrom;
        criteria.StartDateTo = startDateTo;

        await LoadPage(1);
    }

    private async Task GoToPage(int page)
    {
        await LoadPage(page);
    }

    private async Task LoadPage(int page)
    {
        loading = true;
        error = null;
        currentPage = page;
        searchExecuted = true;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            
            // Build query string with all filter parameters
            var queryParams = new List<string>
            {
                $"page={page}",
                $"pageSize={pageSize}"
            };

            if (!string.IsNullOrEmpty(criteria.Keyword))
                queryParams.Add($"keyword={Uri.EscapeDataString(criteria.Keyword)}");

            if (criteria.Statuses.Count > 0)
                queryParams.Add($"status={Uri.EscapeDataString(string.Join(",", criteria.Statuses))}");

            if (criteria.Phases.Count > 0)
                queryParams.Add($"phase={Uri.EscapeDataString(string.Join(",", criteria.Phases))}");

            if (criteria.MeshTreePrefixes.Count > 0)
                queryParams.Add($"meshTree={Uri.EscapeDataString(string.Join(",", criteria.MeshTreePrefixes))}");

            if (criteria.Countries.Length > 0 && !string.IsNullOrEmpty(criteria.Countries[0]))
                queryParams.Add($"country={Uri.EscapeDataString(criteria.Countries[0])}");

            if (criteria.States.Length > 0 && !string.IsNullOrEmpty(criteria.States[0]))
                queryParams.Add($"state={Uri.EscapeDataString(criteria.States[0])}");

            if (criteria.Cities.Length > 0 && !string.IsNullOrEmpty(criteria.Cities[0]))
                queryParams.Add($"city={Uri.EscapeDataString(criteria.Cities[0])}");

            if (criteria.Facilities.Count > 0)
                queryParams.Add($"facility={Uri.EscapeDataString(string.Join(",", criteria.Facilities))}");

            if (criteria.EnrollmentMin.HasValue)
                queryParams.Add($"enrollmentMin={criteria.EnrollmentMin}");

            if (criteria.EnrollmentMax.HasValue)
                queryParams.Add($"enrollmentMax={criteria.EnrollmentMax}");

            if (criteria.StartDateFrom.HasValue)
                queryParams.Add($"startDateFrom={criteria.StartDateFrom.Value:yyyy-MM-dd}");

            if (criteria.StartDateTo.HasValue)
                queryParams.Add($"startDateTo={criteria.StartDateTo.Value:yyyy-MM-dd}");

            var queryString = string.Join("&", queryParams);
            var response = await client.GetFromJsonAsync<StudyListResponse>($"/api/studies?{queryString}");
            
            if (response is not null)
            {
                studies = response.data;
                total = response.total;
                totalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to search studies: {ex.Message}";
            studies = null;
        }
        finally
        {
            loading = false;
        }
    }

    private void ResetFilters()
    {
        criteria = new();
        selectedCountry = null;
        selectedState = null;
        selectedCity = null;
        startDateFrom = null;
        startDateTo = null;
        availableStates.Clear();
        availableCities.Clear();
        availableFacilities.Clear();
        studies = null;
        searchExecuted = false;
        error = null;
    }

    private static List<int?> GetPaginationRange(int current, int total, int maxVisible = 10)
    {
        var range = new List<int?>();
        if (total <= maxVisible)
        {
            for (int i = 1; i <= total; i++) range.Add(i);
            return range;
        }

        int half = maxVisible / 2;
        int start = Math.Max(1, current - half);
        int end = Math.Min(total, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        if (start > 1)
        {
            range.Add(1);
            if (start > 2) range.Add(null);
        }

        for (int i = start; i <= end; i++)
            range.Add(i);

        if (end < total)
        {
            if (end < total - 1) range.Add(null);
            range.Add(total);
        }

        return range;
    }

    private static string StatusColor(string? status) => status switch
    {
        "ACTIVE" or "RECRUITING" => "success",
        "COMPLETED" => "primary",
        "UNKNOWN" or "WITHDRAWN" => "secondary",
        "TERMINATED" or "SUSPENDED" => "danger",
        _ => "warning"
    };

    private class SearchCriteria
    {
        public string? Keyword { get; set; }
        public List<string> Statuses { get; set; } = new();
        public List<string> Phases { get; set; } = new();
        public List<string> MeshTreePrefixes { get; set; } = new();
        public string[] Countries { get; set; } = Array.Empty<string>();
        public string[] States { get; set; } = Array.Empty<string>();
        public string[] Cities { get; set; } = Array.Empty<string>();
        public List<string> Facilities { get; set; } = new();
        public int? EnrollmentMin { get; set; }
        public int? EnrollmentMax { get; set; }
        public DateTime? StartDateFrom { get; set; }
        public DateTime? StartDateTo { get; set; }
    }

    private class StudyListResponse
    {
        public List<StudySummary>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private class StudySummary
    {
        public string? nctId { get; set; }
        public string? briefTitle { get; set; }
        public string? overallStatus { get; set; }
        public List<string>? conditions { get; set; }
        public List<string>? phases { get; set; }
        public int enrollmentCount { get; set; }
    }

    private class LocationsResponse
    {
        public List<string>? countries { get; set; }
        public List<string>? states { get; set; }
        public List<string>? cities { get; set; }
        public List<string>? facilities { get; set; }
    }

}
