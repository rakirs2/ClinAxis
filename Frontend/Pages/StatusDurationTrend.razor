@page "/status/duration-trend"
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Client
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<h1>System Status</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link" href="/status">System Status</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/database">Database Size</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/status/completion">Completion</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="/status/duration-trend">Duration Trend</a>
    </li>
</ul>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (queueStats is null)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else
{
    <div class="mb-3">
        <label class="form-label">Period</label>
        <div class="btn-group" role="group">
            <button class="btn btn-sm @(period == "1h" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriod("1h")'>1h</button>
            <button class="btn btn-sm @(period == "6h" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriod("6h")'>6h</button>
            <button class="btn btn-sm @(period == "24h" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriod("24h")'>24h</button>
            <button class="btn btn-sm @(period == "7d" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPeriod("7d")'>7d</button>
        </div>
    </div>

    @if (queueStats!.byEventType is not null)
    {
        @foreach (var et in queueStats.byEventType)
        {
            var p = et.percentiles;
            if (p is null) continue;

        var cardId = $"card-{et.eventType.Replace(".", "-")}";
        var chartId = $"chart-{et.eventType.Replace(".", "-")}";

        <div class="card mb-4" id="@cardId">
            <div class="card-header">
                <h5 class="mb-0"><code>@et.eventType</code></h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@p.count</h5>
                                <p class="card-text small">Completed</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@(p.minMs.ToString("F1"))ms</h5>
                                <p class="card-text small">Min</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@(p.p50Ms.ToString("F1"))ms</h5>
                                <p class="card-text small">P50</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@(p.p95Ms.ToString("F1"))ms</h5>
                                <p class="card-text small">P95</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@(p.p99Ms.ToString("F1"))ms</h5>
                                <p class="card-text small">P99</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="card-title">@(p.maxMs.ToString("F1"))ms</h5>
                                <p class="card-text small">Max</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="height: 250px;">
                    <canvas id="@chartId"></canvas>
                </div>
            </div>
        </div>
    }
    }
}

@code {
    private QueueStatsResponse? queueStats;
    private string? error;
    private string period = "24h";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task SetPeriod(string p)
    {
        period = p;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            queueStats = await Client.GetFromJsonAsync<QueueStatsResponse>("/api/event-queue/stats");

            if (queueStats?.byEventType is not null)
            {
                foreach (var et in queueStats.byEventType)
                {
                    if (et.percentiles is null) continue;

                    var chartId = $"chart-{et.eventType.Replace(".", "-")}";
                    List<DurationPoint>? history;

                    try
                    {
                        history = await Client.GetFromJsonAsync<List<DurationPoint>>(
                            $"/api/event-queue/duration-history?eventType={Uri.EscapeDataString(et.eventType)}&period={period}&bucketMinutes=60");
                    }
                    catch
                    {
                        continue;
                    }

                    if (history is { Count: > 0 })
                    {
                        var labels = history.Select(h => h.bucket.ToString("MM-dd HH:mm")).ToList();
                        var datasets = new[]
                        {
                            new
                            {
                                label = "P50",
                                data = history.Select(h => h.p50Ms).ToList(),
                                backgroundColor = "rgba(54, 162, 235, 0.6)",
                                borderColor = "rgba(54, 162, 235, 1)",
                                borderWidth = 1
                            },
                            new
                            {
                                label = "P95",
                                data = history.Select(h => h.p95Ms).ToList(),
                                backgroundColor = "rgba(255, 159, 64, 0.6)",
                                borderColor = "rgba(255, 159, 64, 1)",
                                borderWidth = 1
                            },
                            new
                            {
                                label = "P99",
                                data = history.Select(h => h.p99Ms).ToList(),
                                backgroundColor = "rgba(255, 99, 132, 0.6)",
                                borderColor = "rgba(255, 99, 132, 1)",
                                borderWidth = 1
                            }
                        };

                        await JsRuntime.InvokeVoidAsync("chartInterop.createBarChart", chartId, labels, datasets);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load duration trend data: {ex.Message}";
        }
    }

    private class QueueStatsResponse
    {
        public int pendingCount { get; set; }
        public int processingCount { get; set; }
        public int completedCount { get; set; }
        public int deadLetterCount { get; set; }
        public int failedCount { get; set; }
        public double averageProcessingTimeMs { get; set; }
        public double failureRate { get; set; }
        public double? estimatedTimeRemainingMs { get; set; }
        public List<EventTypeItem>? byEventType { get; set; }
    }

    private class EventTypeItem
    {
        public string eventType { get; set; } = string.Empty;
        public int pending { get; set; }
        public int processing { get; set; }
        public int completed { get; set; }
        public int failed { get; set; }
        public int deadLetter { get; set; }
        public double averageProcessingTimeMs { get; set; }
        public DurationPercentilesItem? percentiles { get; set; }
    }

    private class DurationPercentilesItem
    {
        public int count { get; set; }
        public double minMs { get; set; }
        public double p50Ms { get; set; }
        public double p95Ms { get; set; }
        public double p99Ms { get; set; }
        public double maxMs { get; set; }
    }

    private class DurationPoint
    {
        public DateTime bucket { get; set; }
        public int count { get; set; }
        public double averageMs { get; set; }
        public double p50Ms { get; set; }
        public double p95Ms { get; set; }
        public double p99Ms { get; set; }
    }
}