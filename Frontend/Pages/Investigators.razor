@page "/investigators"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@implements IDisposable

<h1>Principal Investigators</h1>

<div class="row mb-3">
    <div class="col-md-6">
        <input @bind="search" @bind:event="oninput" class="form-control" placeholder="Search by investigator name"
               @onkeydown="HandleKeyDown" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="SearchInvestigators" disabled="@loading">Search</button>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center mt-4">
        <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (investigators is not null)
{
    @if (investigators.Count == 0)
    {
        <p class="text-muted">No investigators found.</p>
    }
    else
    {
        <p class="text-muted">Showing @investigators.Count of @total investigators</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Affiliation</th>
                    <th>Studies</th>
                    <th>Papers</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in investigators)
                {
                    <tr>
                        <td><a href="/investigator/@inv.uuid">@inv.name</a></td>
                        <td>@inv.primaryAffiliation</td>
                        <td>@inv.studyCount</td>
                        <td>@inv.paperCount</td>
                    </tr>
                }
            </tbody>
        </table>

        <nav>
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                </li>
                @foreach (var p in GetPaginationRange(currentPage, totalPages))
                {
                    if (p is null)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(p.Value)">@p</button>
                        </li>
                    }
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private string search = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int total;
    private int totalPages;
    private bool loading;
    private string? error;
    private List<InvestigatorItem>? investigators;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
        _timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (!loading) await LoadPage(currentPage);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchInvestigators();
        }
    }

    private async Task SearchInvestigators()
    {
        await LoadPage(1);
    }

    private async Task GoToPage(int page)
    {
        await LoadPage(page);
    }

    private async Task LoadPage(int page)
    {
        loading = true;
        error = null;
        currentPage = page;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("DataApi");
            string url = $"/api/investigators?page={page}&pageSize={pageSize}&hasNpi=true";
            if (!string.IsNullOrEmpty(search))
            {
                url += $"&search={Uri.EscapeDataString(search)}";
            }
            var response = await client.GetFromJsonAsync<InvestigatorListResponse>(url);
            if (response is not null)
            {
                investigators = response.data;
                total = response.total;
                totalPages = response.totalPages;
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load investigators: {ex.Message}";
            investigators = null;
        }
        finally
        {
            loading = false;
        }
    }

    private class InvestigatorListResponse
    {
        public List<InvestigatorItem>? data { get; set; }
        public int total { get; set; }
        public int page { get; set; }
        public int pageSize { get; set; }
        public int totalPages { get; set; }
    }

    private static List<int?> GetPaginationRange(int current, int total, int maxVisible = 10)
    {
        var range = new List<int?>();
        if (total <= maxVisible)
        {
            for (int i = 1; i <= total; i++) range.Add(i);
            return range;
        }

        int half = maxVisible / 2;
        int start = Math.Max(1, current - half);
        int end = Math.Min(total, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
            start = Math.Max(1, end - maxVisible + 1);

        if (start > 1)
        {
            range.Add(1);
            if (start > 2) range.Add(null);
        }

        for (int i = start; i <= end; i++)
            range.Add(i);

        if (end < total)
        {
            if (end < total - 1) range.Add(null);
            range.Add(total);
        }

        return range;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private class InvestigatorItem
    {
        public Guid uuid { get; set; }
        public string? name { get; set; }
        public string? npi { get; set; }
        public int studyCount { get; set; }
        public int paperCount { get; set; }
        public string? primaryAffiliation { get; set; }
    }
}
