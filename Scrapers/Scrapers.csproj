<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903;CA1724;CA2007;CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scrapers.Tests" />
    <InternalsVisibleTo Include="Scrapers.IntegrationTests" />
    <InternalsVisibleTo Include="Scrapers.Validation" />
    <InternalsVisibleTo Include="IngestionApp" />
    <InternalsVisibleTo Include="DataApi" />
    <InternalsVisibleTo Include="MeshCompare" />
    <InternalsVisibleTo Include="ABTestRunner" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Resources\" />
  </ItemGroup>

</Project>
