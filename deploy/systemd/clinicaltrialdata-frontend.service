[Unit]
Description=Clinical Trial Data - Frontend Service
After=network.target clinicaltrialdata-api.service
Requires=clinicaltrialdata-api.service

[Service]
Type=simple
User=ct-deploy
WorkingDirectory=/opt/clinicaltrialdata/frontend
EnvironmentFile=/etc/clinicaltrialdata.env
Environment="ASPNETCORE_ENVIRONMENT=Production"
Environment="ASPNETCORE_URLS=http://localhost:5001"
ExecStart=/opt/clinicaltrialdata/frontend/Frontend
ExecStop=/bin/sh -c 'kill -TERM $MAINPID 2>/dev/null; sleep 5; /usr/bin/fuser -k 5001/tcp 2>/dev/null || true'
TimeoutStopSec=15
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
