[Unit]
Description=Clinical Trial Data - DataApi Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ct-deploy
WorkingDirectory=/opt/clinicaltrialdata/api
EnvironmentFile=/etc/clinicaltrialdata.env
Environment="ASPNETCORE_ENVIRONMENT=Production"
Environment="ASPNETCORE_URLS=http://localhost:5003"
ExecStart=/opt/clinicaltrialdata/api/DataApi
ExecStop=/bin/sh -c 'kill -TERM $MAINPID 2>/dev/null; sleep 5; /usr/bin/fuser -k 5003/tcp 2>/dev/null || true'
TimeoutStopSec=15
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
