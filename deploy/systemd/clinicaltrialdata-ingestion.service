[Unit]
Description=Clinical Trial Data - Ingestion Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ct-deploy
WorkingDirectory=/opt/clinicaltrialdata/ingestion
EnvironmentFile=/etc/clinicaltrialdata.env
Environment="ASPNETCORE_ENVIRONMENT=Production"
ExecStart=/opt/clinicaltrialdata/ingestion/IngestionApp
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
